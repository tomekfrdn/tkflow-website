---
// Hero.astro — WebGL Hydrodynamic Stream Shader (Kaustyka, Refrakcja, Kierunkowy Przepływ)
---

<section
  data-hero
  class="relative w-full min-h-[100svh] bg-[#020B14] text-white flex flex-col justify-between pt-20 sm:pt-24 pb-8 px-6 md:px-12 overflow-hidden select-none border-b border-white/10"
>
  <!-- CANVAS WEBGL: Symulacja żywego, ukierunkowanego strumienia wody z kaustyką -->
  <canvas
    id="water-stream-canvas"
    class="absolute inset-0 w-full h-full pointer-events-none z-0"
  ></canvas>

  <!-- Winieta optyczna i subtelna głębia -->
  <div class="absolute inset-0 bg-radial-vignette pointer-events-none z-0 opacity-40"></div>

  <!-- 1. GÓRNY PASEK KOMUNIKACJI -->
