---
// Hero.astro — The Pressure Chamber & Fluid Bifurcation
---

<section
  data-hero
  class="relative w-full h-[100svh] min-h-[700px] bg-[#080A0D] text-white flex flex-col justify-between overflow-hidden select-none border-b border-white/10"
>
  <!-- TŁO: Siatka kreślarska CAD / Ciśnieniomierz w tle -->
  <div
    class="absolute inset-0 opacity-[0.04] pointer-events-none z-0"
    style="background-image: linear-gradient(#fff 1px, transparent 1px), linear-gradient(90deg, #fff 1px, transparent 1px); background-size: 48px 48px;"
  ></div>

  <!-- 1. GÓRNA DYSPOZYTORNIA: TK FLOW CENTRAL CORE -->
  <div class="relative z-30 pt-20 sm:pt-24 px-6 md:px-12 flex flex-col md:flex-row md:items-end justify-between gap-4 pb-4 border-b border-white/10 bg-[#080A0D]/60 backdrop-blur-sm">
    <div>
      <div class="flex items-center gap-2.5 font-mono text-[10px] tracking-[0.3em] uppercase text-[#FF5500] mb-1">
        <span class="w-2 h-2 rounded-none bg-[#FF5500] animate-pulse"></span>
        <span>MAIN PRESSURE CORE // DISPATCH UNIT 01</span>
      </div>
      <h1 class="font-display text-2xl sm:text-3xl lg:text-4xl font-extrabold uppercase tracking-tight text-white flex items-baseline gap-3">
        <span>TK FLOW</span>
        <span class="font-mono text-xs tracking-widest text-[#9AA4B2] font-normal uppercase hidden sm:inline-block">
          / ARCHITEKTURA PRZEPŁYWU CIECZY
        </span>
      </h1>
    </div>

    <!-- Telemetria SCADA w prawym rogu -->
    <div class="flex items-center gap-6 font-mono text-[11px] text-[#9AA4B2]">
      <div class="hidden sm:block">
        <span class="text-white/40 block text-[9px] uppercase">STATUS ROZDZIELACZA</span>
        <span class="text-emerald-400 font-semibold flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> BIFURCATION ACTIVE
        </span>
      </div>
      <div class="border-l border-white/10 pl-6">
        <span class="text-white/40 block text-[9px] uppercase">DYNAMICZNA SELEKCJA</span>
        <span class="text-white font-medium">[ WYBIERZ STRUMIEŃ ]</span>
      </div>
    </div>
  </div>

  <!-- 2. CENTRAL BIFURCATION: DWA STRUMIENIE ENERGII WODY (INTERACTIVE SPLIT) -->
  <div
    data-chamber-split
    class="relative z-20 flex-1 flex flex-col lg:flex-row w-full h-full overflow-hidden transition-all duration-700 ease-out"
  >

    <!-- ================= STRUMIEŃ 01: LOW PRESSURE / VOLUME (RURAPE.PL) ================= -->
    <a
      href="https://rurape.pl"
      target="_blank"
      rel="noopener noreferrer"
      data-stream="agro"
      class="group relative flex-1 flex flex-col justify-between p-6 sm:p-10 lg:p-12 border-b lg:border-b-0 lg:border-r border-white/10 overflow-hidden bg-gradient-to-b lg:bg-gradient-to-br from-[#0A1210]/95 via-[#080E0D]/90 to-[#060A09]/95 transition-all duration-700 cursor-pointer"
    >
      <!-- Subtelna poświata Agro Szmaragd -->
      <div class="absolute -top-32 -left-32 w-96 h-96 bg-emerald-500/10 rounded-full blur-[100px] pointer-events-none group-hover:bg-emerald-500/20 transition-all duration-700"></div>

      <!-- Top info strumienia -->
      <div class="relative z-10 flex justify-between items-start">
        <div class="font-mono">
          <span class="inline-block px-2.5 py-1 text-[10px] uppercase tracking-widest bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 rounded-none mb-2 font-semibold">
            STRUMIEŃ 01 // LOW PRESSURE & VOLUME
          </span>
          <p class="text-xs text-white/50 tracking-wider">MAGISTRALE NAWADNIANIA ZIEMI</p>
        </div>
        <div class="w-10 h-10 border border-emerald-500/30 flex items-center justify-center text-emerald-400 group-hover:bg-emerald-400 group-hover:text-black group-hover:border-emerald-400 transition-all duration-300">
          <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" />
          </svg>
        </div>
      </div>

      <!-- Treść centralna strumienia -->
      <div class="relative z-10 my-auto py-4">
        <span class="font-mono text-xs tracking-[0.25em] text-emerald-400 uppercase block mb-1 font-medium">
          Przepływ ciągły • Skala • Odporność gruntu
        </span>
        <h2 class="font-display text-4xl sm:text-5xl lg:text-6xl 2xl:text-7xl font-extrabold uppercase tracking-tight text-white group-hover:text-emerald-400 transition-colors">
          RURAPE.PL
        </h2>
        <p class="font-sans text-sm sm:text-base text-[#9AA4B2] mt-3 max-w-lg leading-relaxed">
          Certyfikowane rury polietylenowe PE100 oraz PE100-RC do magistrali irygacyjnych i zasilania upraw rolnych. Niezawodność w wieloletnim kontakcie ze środowiskiem glebowym.
        </p>

        <!-- Matryca telemetryczna widoczna po rozwinięciu -->
        <div class="grid grid-cols-3 gap-4 mt-6 pt-6 border-t border-white/10 font-mono text-xs opacity-75 group-hover:opacity-100 transition-opacity">
          <div>
            <span class="text-[9px] text-white/40 block">MATERIAŁ</span>
            <span class="text-white font-medium">PE100 / RC</span>
          </div>
          <div>
            <span class="text-[9px] text-white/40 block">ŚRODOWISKO</span>
            <span class="text-white font-medium">AGRO / GRUNT</span>
          </div>
          <div>
            <span class="text-[9px] text-white/40 block">SPECYFIKACJA</span>
            <span class="text-emerald-400 font-medium">KATALOG &rarr;</span>
          </div>
        </div>
      </div>

      <!-- Dolny wskaźnik przekierowania -->
      <div class="relative z-10 pt-4 flex items-center justify-between font-mono text-[11px] text-white/50 border-t border-white/5">
        <span class="tracking-widest uppercase text-emerald-400/80">rurape.pl</span>
        <span class="group-hover:text-emerald-400 group-hover:translate-x-1 transition-all">OTWÓRZ STRUMIEŃ OBJĘTOŚCIOWY &rarr;</span>
      </div>
    </a>


    <!-- ================= STRUMIEŃ 02: HIGH PRESSURE / FORCE (SERCEMYJNI.PL) ================= -->
    <a
      href="https://sercemyjni.pl"
      target="_blank"
      rel="noopener noreferrer"
      data-stream="wash"
      class="group relative flex-1 flex flex-col justify-between p-6 sm:p-10 lg:p-12 overflow-hidden bg-gradient-to-b lg:bg-gradient-to-br from-[#140E0A]/95 via-[#100C09]/90 to-[#0A0807]/95 transition-all duration-700 cursor-pointer"
    >
      <!-- Subtelna poświata Industrial Amber / Orange -->
      <div class="absolute -top-32 -right-32 w-96 h-96 bg-[#FF5500]/10 rounded-full blur-[100px] pointer-events-none group-hover:bg-[#FF5500]/25 transition-all duration-700"></div>

      <!-- Top info strumienia -->
      <div class="relative z-10 flex justify-between items-start">
        <div class="font-mono">
          <span class="inline-block px-2.5 py-1 text-[10px] uppercase tracking-widest bg-[#FF5500]/10 text-[#FF5500] border border-[#FF5500]/30 rounded-none mb-2 font-semibold">
            STRUMIEŃ 02 // HIGH PRESSURE & FORCE
          </span>
          <p class="text-xs text-white/50 tracking-wider">ENERGIA KINETYCZNA & HYDRAULIKA SIŁOWA</p>
        </div>
        <div class="w-10 h-10 border border-[#FF5500]/30 flex items-center justify-center text-[#FF5500] group-hover:bg-[#FF5500] group-hover:text-black group-hover:border-[#FF5500] transition-all duration-300">
          <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" />
          </svg>
        </div>
      </div>

      <!-- Treść centralna strumienia -->
      <div class="relative z-10 my-auto py-4">
        <span class="font-mono text-xs tracking-[0.25em] text-[#FF5500] uppercase block mb-1 font-medium">
          200 Barów • Nurniki ceramiczne • Chemia myjni
        </span>
        <h2 class="font-display text-4xl sm:text-5xl lg:text-6xl 2xl:text-7xl font-extrabold uppercase tracking-tight text-white group-hover:text-[#FF5500] transition-colors">
          SERCEMYJNI.PL
        </h2>
        <p class="font-sans text-sm sm:text-base text-[#9AA4B2] mt-3 max-w-lg leading-relaxed">
          Niezawodne pompy wysokociśnieniowe do bezdotykowych myjni samochodowych. Precyzja jednostek napędowych przystosowanych do bezustannej eksploatacji 24/7.
        </p>

        <!-- Matryca telemetryczna widoczna po rozwinięciu -->
        <div class="grid grid-cols-3 gap-4 mt-6 pt-6 border-t border-white/10 font-mono text-xs opacity-75 group-hover:opacity-100 transition-opacity">
          <div>
            <span class="text-[9px] text-white/40 block">CIŚNIENIE ROBOCZE</span>
            <span class="text-white font-medium">DO 200+ BAR</span>
          </div>
          <div>
            <span class="text-[9px] text-white/40 block">EKSPLOATACJA</span>
            <span class="text-white font-medium">HEAVY DUTY 24/7</span>
          </div>
          <div>
            <span class="text-[9px] text-white/40 block">SPECYFIKACJA</span>
            <span class="text-[#FF5500] font-medium">KATALOG &rarr;</span>
          </div>
        </div>
      </div>

      <!-- Dolny wskaźnik przekierowania -->
      <div class="relative z-10 pt-4 flex items-center justify-between font-mono text-[11px] text-white/50 border-t border-white/5">
        <span class="tracking-widest uppercase text-[#FF5500]/80">sercemyjni.pl</span>
        <span class="group-hover:text-[#FF5500] group-hover:translate-x-1 transition-all">OTWÓRZ STRUMIEŃ SIŁOWY &rarr;</span>
      </div>
    </a>

  </div>

  <!-- 3. DOLNA KONTROLA: ZJAZD DO PROFILU INŻYNIERA -->
  <div class="relative z-30 px-6 md:px-12 py-3 bg-[#080A0D] border-t border-white/10 flex items-center justify-between font-mono text-xs text-[#9AA4B2]">
    <div class="flex items-center gap-3">
      <span class="w-1.5 h-1.5 bg-[#FF5500]"></span>
      <span class="text-[11px] tracking-widest uppercase">TK FLOW // TOMASZ KULPA</span>
    </div>

    <a
      href="#about"
      class="group flex items-center gap-3 text-white/70 hover:text-white transition-colors"
      aria-label="Przejdź do profilu doradcy"
    >
      <span class="text-[10px] sm:text-[11px] tracking-widest uppercase text-[#9AA4B2] group-hover:text-[#FF5500] transition-colors">
        DORADZTWO TECHNICZNE
      </span>
      <div class="w-7 h-7 rounded-full border border-white/20 flex items-center justify-center group-hover:border-[#FF5500] group-hover:bg-[#FF5500]/10 transition-colors">
        <svg class="w-3.5 h-3.5 stroke-[2] transition-transform duration-300 group-hover:translate-y-0.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
        </svg>
      </div>
    </a>
  </div>
</section>

<script>
  import { DOMLoaded } from '@/ts/events'

  DOMLoaded(() => {
    // Interaktywne rozszerzanie kolumn na desktopie (Bifurcation Fluid Width)
    const streamAgro = document.querySelector('[data-stream="agro"]') as HTMLElement
    const streamWash = document.querySelector('[data-stream="wash"]') as HTMLElement

    if (streamAgro && streamWash && window.innerWidth >= 1024) {
      // Hover Agro -> rozszerz lewą stronę
      streamAgro.addEventListener('mouseenter', () => {
        streamAgro.style.flex = '1.75'
        streamWash.style.flex = '0.75'
      })

      // Hover Wash -> rozszerz prawą stronę
      streamWash.addEventListener('mouseenter', () => {
        streamWash.style.flex = '1.75'
        streamAgro.style.flex = '0.75'
      })

      // Wyjście kursora -> powrót do równego podziału 50 / 50
      const chamber = document.querySelector('[data-chamber-split]')
      chamber?.addEventListener('mouseleave', () => {
        streamAgro.style.flex = '1'
        streamWash.style.flex = '1'
      })
    }
  })
</script>