<section data-hero class="relative w-full h-[100dvh] bg-brand-water text-white">
  <div class="absolute inset-0 overflow-clip">
    <video
      data-hero-video
      class="w-full h-full object-cover"
      autoplay
      muted
      playsinline
      loop
    >
      <source src="/images/hero-bg.mp4" type="video/mp4" />
    </video>
  </div>
  <div class="absolute inset-0 bg-dark-blue/75"></div>

  <!-- Minimalistyczna strzałka w dół (zawsze w widocznym oknie 100dvh) -->
  <div
    data-scroll-hint
    class="absolute bottom-6 pb-[env(safe-area-inset-bottom)] sm:bottom-12 inset-x-0 z-20 flex justify-center pointer-events-auto"
  >
    <a
      href="#about"
      class="p-3 text-white/60 hover:text-white transition-colors duration-300"
      aria-label="Przewiń w dół do sekcji o marce"
    >
      <svg
        class="w-6 h-6 animate-bounce stroke-[1.5]"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M19.5 8.25l-7.5 7.5-7.5-7.5"
        />
      </svg>
    </a>
  </div>
</section>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  import { DOMLoaded } from '@/ts/events'

  DOMLoaded(() => {
    gsap.registerPlugin(ScrollTrigger)
    const hero = document.querySelector('[data-hero]') as HTMLElement
    const heroVideo = document.querySelector(
      '[data-hero-video]'
    ) as HTMLVideoElement
    const scrollHint = document.querySelector(
      '[data-scroll-hint]'
    ) as HTMLElement

    if (hero && heroVideo) {
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: hero,
          start: 'top top',
          end: 'bottom top',
          scrub: true,
        },
      })

      tl.to(heroVideo, { y: '50%', duration: 1 })

      // Szybkie wygaszenie strzałki
      if (scrollHint) {
        tl.to(scrollHint, { opacity: 0, y: 10, duration: 0.15 }, 0)
      }
    }

    // Płynne przewijanie do sekcji About po kliknięciu
    if (scrollHint) {
      const link = scrollHint.querySelector('a')
      link?.addEventListener('click', (e) => {
        e.preventDefault()
        const target = document.querySelector('[data-about]')
        target?.scrollIntoView({ behavior: 'smooth' })
      })
    }
  })
</script>