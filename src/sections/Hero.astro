---
// Hero.astro — The Hydraulic Splitter (Hydrodynamiczny Rozdzielacz 3D)
---

<section
  data-hero
  class="relative w-full min-h-[100svh] bg-gradient-to-b from-[#020B14] via-[#041A2F] to-[#0A2E4E] text-white flex flex-col justify-between pt-20 sm:pt-24 pb-8 px-4 sm:px-8 md:px-12 overflow-hidden select-none border-b border-white/10"
>
  <!-- CANVAS HYDRODYNAMICZNY: Płynąca, nasycona woda z bąblami i ciśnieniem -->
  <canvas
    id="hydro-canvas"
    class="absolute inset-0 w-full h-full pointer-events-none z-0 opacity-80 mix-blend-screen"
  ></canvas>

  <!-- Subtelna siatka pomiarowa ciśnienia -->
  <div
    class="absolute inset-0 opacity-[0.06] pointer-events-none z-0"
    style="background-image: radial-gradient(circle at 1px 1px, #fff 1px, transparent 0); background-size: 32px 32px;"
  ></div>

  <!-- 1. GÓRNY PASEK POZYCJONUJĄCY: CENTRAL FLOW AUTHORITY -->
  <div class="relative z-10 max-w-7xl mx-auto w-full flex flex-col sm:flex-row sm:items-end justify-between gap-4 pt-4 pb-4 border-b border-white/15">
    <div>
      <div class="flex items-center gap-2 font-mono text-[10px] sm:text-[11px] tracking-[0.25em] uppercase text-[#0098E0] font-bold">
        <span class="w-2 h-2 rounded-full bg-[#0098E0] animate-ping"></span>
        <span>CENTRALNY WĘZEŁ PRZESYŁU WODY // DYSTRYBUCJA I DORADZTWO</span>
      </div>
      <h1 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold uppercase tracking-tight text-white mt-1 drop-shadow-md">
        KONTROLA PRZEPŁYWU WODY
      </h1>
    </div>

    <div class="font-mono text-xs text-[#8FAEC4] hidden md:flex items-center gap-6">
      <div>
        <span class="block text-[9px] uppercase text-white/40">ZAKRES CIŚNIEŃ</span>
        <span class="text-white font-semibold">0 — 200+ BAR</span>
      </div>
      <div class="border-l border-white/15 pl-6">
        <span class="block text-[9px] uppercase text-white/40">DORADZTWO</span>
        <span class="text-emerald-400 font-semibold">TOMASZ KULPA</span>
      </div>
    </div>
  </div>

  <!-- 2. SERCE HERO: THE HYDRAULIC SPLITTER (DWA STRUMIENIE FIZYCZNE) -->
  <div class="relative z-20 flex-1 flex flex-col justify-center my-auto max-w-7xl mx-auto w-full py-6">
    <div class="text-center max-w-2xl mx-auto mb-8">
      <p class="font-sans text-sm sm:text-base text-[#8FAEC4] font-light leading-relaxed">
        Łączymy bezpośrednią dystrybucję wiodących europejskich producentów z praktycznym doradztwem technicznym. Wybierz gałąź przesyłu wody dla swojej inwestycji:
      </p>
    </div>

    <!-- DWA WIELKIE PORTALE STRUMIENI (SPLIT GATE) -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8">
      
      <!-- ================= PORTAL 01: RURAPE.PL (NAWADNIANIE AGRO) ================= -->
      <a
        href="https://rurape.pl"
        target="_blank"
        rel="noopener noreferrer"
        data-portal-agro
        class="group relative flex flex-col justify-between p-8 sm:p-10 rounded-2xl bg-gradient-to-br from-[#061D19]/90 to-[#031310]/95 border-2 border-emerald-500/40 hover:border-emerald-400 shadow-[0_10px_40px_rgba(4,120,87,0.2)] hover:shadow-[0_15px_50px_rgba(4,120,87,0.4)] transition-all duration-500 overflow-hidden"
      >
        <!-- Rozbłysk wody wewnątrz karty -->
        <div class="absolute -top-24 -right-24 w-72 h-72 bg-emerald-500/15 rounded-full blur-[70px] group-hover:bg-emerald-500/30 transition-all duration-700 pointer-events-none"></div>

        <div>
          <!-- Top badge -->
          <div class="flex items-center justify-between font-mono text-xs mb-6">
            <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/20 text-emerald-300 font-bold uppercase tracking-wider text-[11px] border border-emerald-500/40">
              <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
              Strumień 01 // Przepływ Objętościowy
            </span>
            <span class="text-emerald-400 font-semibold group-hover:translate-x-0.5 transition-transform">
              rurape.pl &nearr;
            </span>
          </div>

          <span class="font-mono text-xs text-emerald-400 font-semibold uppercase tracking-widest block mb-1">
            Rolnictwo &middot; Sady &middot; Plantacje &middot; Irygacja
          </span>
          <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white group-hover:text-emerald-300 transition-colors uppercase tracking-tight">
            Rury PE do Nawadniania
          </h2>
          <p class="font-sans text-sm sm:text-base text-slate-300 mt-3 leading-relaxed">
            Certyfikowane rury polietylenowe PE100 oraz PE100-RC do magistrali irygacyjnych i systemów kroplujących. Wysoka odporność na ciśnienie, promieniowanie UV oraz naprężenia gruntu.
          </p>

          <!-- Parametry techniczne -->
          <div class="grid grid-cols-3 gap-3 mt-6 pt-6 border-t border-white/10 font-mono text-xs">
            <div>
              <span class="block text-[10px] text-white/40 uppercase">Gatunek</span>
              <span class="text-white font-bold">PE100 / RC</span>
            </div>
            <div>
              <span class="block text-[10px] text-white/40 uppercase">Średnice</span>
              <span class="text-white font-bold">16 — 110 mm</span>
            </div>
            <div>
              <span class="block text-[10px] text-white/40 uppercase">Dostawa</span>
              <span class="text-emerald-400 font-bold">Zwoje / Sztangi</span>
            </div>
          </div>
        </div>

        <!-- Wielki, jasny CTA -->
        <div class="mt-8 pt-2">
          <div class="inline-flex items-center justify-between w-full py-4 px-6 rounded-xl bg-emerald-600 group-hover:bg-emerald-500 text-white font-mono text-xs uppercase tracking-wider font-bold transition-all shadow-lg">
            <span>Przejdź do oferty rur: rurape.pl</span>
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </div>
        </div>
      </a>

      <!-- ================= PORTAL 02: SERCEMYJNI.PL (WYSOKIE CIŚNIENIE) ================= -->
      <a
        href="https://sercemyjni.pl"
        target="_blank"
        rel="noopener noreferrer"
        data-portal-wash
        class="group relative flex flex-col justify-between p-8 sm:p-10 rounded-2xl bg-gradient-to-br from-[#240B13]/90 to-[#14060B]/95 border-2 border-rose-500/40 hover:border-rose-400 shadow-[0_10px_40px_rgba(190,18,60,0.2)] hover:shadow-[0_15px_50px_rgba(190,18,60,0.4)] transition-all duration-500 overflow-hidden"
      >
        <!-- Rozbłysk wody wewnątrz karty -->
        <div class="absolute -top-24 -right-24 w-72 h-72 bg-rose-500/15 rounded-full blur-[70px] group-hover:bg-rose-500/30 transition-all duration-700 pointer-events-none"></div>

        <div>
          <!-- Top badge -->
          <div class="flex items-center justify-between font-mono text-xs mb-6">
            <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-rose-500/20 text-rose-300 font-bold uppercase tracking-wider text-[11px] border border-rose-500/40">
              <span class="w-2 h-2 rounded-full bg-rose-400"></span>
              Strumień 02 // Kinetyczna Siła Ciśnienia
            </span>
            <span class="text-rose-400 font-semibold group-hover:translate-x-0.5 transition-transform">
              sercemyjni.pl &nearr;
            </span>
          </div>

          <span class="font-mono text-xs text-rose-400 font-semibold uppercase tracking-widest block mb-1">
            Myjnie Bezdotykowe &middot; Agregaty Przemysłowe &middot; Udor
          </span>
          <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white group-hover:text-rose-300 transition-colors uppercase tracking-tight">
            Pompy do Myjni
          </h2>
          <p class="font-sans text-sm sm:text-base text-slate-300 mt-3 leading-relaxed">
            Wysokociśnieniowe pompy nurnikowe włoskiej marki Udor, oryginalne części zamienne oraz fachowy dobór podzespołów do ciągłej pracy w warunkach agresywnej chemii myjącej.
          </p>

          <!-- Parametry techniczne -->
          <div class="grid grid-cols-3 gap-3 mt-6 pt-6 border-t border-white/10 font-mono text-xs">
            <div>
              <span class="block text-[10px] text-white/40 uppercase">Ciśnienie</span>
              <span class="text-white font-bold">Do 200 bar</span>
            </div>
            <div>
              <span class="block text-[10px] text-white/40 uppercase">Konstrukcja</span>
              <span class="text-white font-bold">Nurniki Ceramiczne</span>
            </div>
            <div>
              <span class="block text-[10px] text-white/40 uppercase">Producent</span>
              <span class="text-rose-400 font-bold">UDOR (Włochy)</span>
            </div>
          </div>
        </div>

        <!-- Wielki, jasny CTA -->
        <div class="mt-8 pt-2">
          <div class="inline-flex items-center justify-between w-full py-4 px-6 rounded-xl bg-rose-600 group-hover:bg-rose-500 text-white font-mono text-xs uppercase tracking-wider font-bold transition-all shadow-lg">
            <span>Przejdź do pomp Udor: sercemyjni.pl</span>
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </div>
        </div>
      </a>

    </div>
  </div>

  <!-- 3. DOLNY STATUS OPERACYJNY: PRZEJŚCIE DO DORADCY -->
  <div class="relative z-10 pt-4 flex flex-col sm:flex-row items-center justify-between border-t border-white/15 text-xs text-[#8FAEC4] font-mono gap-3">
    <div class="flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
      <span>DORADCA PROWADZĄCY: <strong>TOMASZ KULPA</strong></span>
    </div>

    <a
      href="#about"
      class="hover:text-white transition-colors flex items-center gap-2 uppercase tracking-wider font-semibold text-[11px] group"
    >
      <span>Poznaj zaplecze inżynieryjne TK Flow</span>
      <span class="group-hover:translate-y-0.5 transition-transform">&darr;</span>
    </a>
  </div>
</section>

<!-- SKRYPT SYMULACJI GŁĘBOKIEGO PRZEPŁYWU WODY NA CANVASIE -->
<script>
  import { DOMLoaded } from '@/ts/events'

  DOMLoaded(() => {
    const canvas = document.getElementById('hydro-canvas') as HTMLCanvasElement
    if (!canvas) return

    const ctx = canvas.getContext('2d')
    if (!ctx) return

    let width = (canvas.width = window.innerWidth)
    let height = (canvas.height = window.innerHeight)

    window.addEventListener('resize', () => {
      width = canvas.width = window.innerWidth
      height = canvas.height = window.innerHeight
    })

    // Generator cząsteczek wody i bąbli kawitacyjnych
    const particles: Array<{
      x: number
      y: number
      radius: number
      speedY: number
      speedX: number
      alpha: number
      waveOffset: number
    }> = []

    for (let i = 0; i < 45; i++) {
      particles.push({
        x: Math.random() * width,
        y: Math.random() * height,
        radius: Math.random() * 3 + 1,
        speedY: Math.random() * 2 + 1.2,
        speedX: (Math.random() - 0.5) * 0.8,
        alpha: Math.random() * 0.5 + 0.2,
        waveOffset: Math.random() * Math.PI * 2,
      })
    }

    let time = 0

    const render = () => {
      ctx.clearRect(0, 0, width, height)
      time += 0.015

      // 1. Warstwa diagonalnych wstęg błękitnego strumienia wody
      for (let i = 0; i < 6; i++) {
        ctx.beginPath()
        const yStart = (height / 5) * i
        ctx.moveTo(0, yStart)

        for (let x = 0; x <= width; x += 30) {
          const wave = Math.sin(x * 0.002 + time + i) * 35 + Math.cos(x * 0.004 + time * 1.5) * 20
          ctx.lineTo(x, yStart + wave)
        }

        const gradient = ctx.createLinearGradient(0, 0, width, height)
        gradient.addColorStop(0, 'rgba(0, 152, 224, 0.18)')
        gradient.addColorStop(0.5, 'rgba(0, 91, 153, 0.25)')
        gradient.addColorStop(1, 'rgba(0, 152, 224, 0.05)')

        ctx.strokeStyle = gradient
        ctx.lineWidth = 14 + i * 4
        ctx.stroke()
      }

      // 2. Warstwa bąbli kawitacyjnych pod ciśnieniem
      for (const p of particles) {
        p.y -= p.speedY
        p.x += Math.sin(time + p.waveOffset) * 0.8 + p.speedX

        if (p.y < -10) {
          p.y = height + 10
          p.x = Math.random() * width
        }

        ctx.beginPath()
        ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2)
        ctx.fillStyle = `rgba(255, 255, 255, ${p.alpha})`
        ctx.shadowColor = '#0098E0'
        ctx.shadowBlur = 10
        ctx.fill()
        ctx.shadowBlur = 0
      }

      requestAnimationFrame(render)
    }

    render()
  })
</script>