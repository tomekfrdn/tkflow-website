---
// Hero.astro — The Clean Split Gate (Dwie drogi przepływu)
---

<section
  data-hero
  class="relative w-full min-h-[100svh] lg:h-[100svh] bg-[#F8FAFC] text-[#0F172A] flex flex-col justify-between pt-20 sm:pt-24 pb-6 px-4 sm:px-8 md:px-12 overflow-hidden border-b border-slate-200"
>
  <!-- Subtelna inżynieryjna siatka CAD w tle -->
  <div
    class="absolute inset-0 opacity-[0.035] pointer-events-none"
    style="background-image: linear-gradient(#000 1px, transparent 1px), linear-gradient(90deg, #000 1px, transparent 1px); background-size: 40px 40px;"
  ></div>

  <!-- Komunikat wprowadzający: Czym jest TK Flow (Zrozumiałe w 3 sekundy) -->
  <div class="relative z-10 max-w-4xl mx-auto text-center pt-4 pb-6">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-100 border border-slate-200 text-slate-700 font-mono text-[11px] tracking-wider uppercase mb-3 font-semibold">
      <span class="w-2 h-2 rounded-full bg-[#00A3E0]"></span>
      <span>Centrala Doradztwa i Dystrybucji Komponentów Wodnych</span>
    </div>
    <h1 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold uppercase tracking-tight text-[#041A2F] leading-tight">
      Dedykowane Rozwiązania do Przesyłu Wody
    </h1>
    <p class="font-sans text-sm sm:text-base text-slate-600 max-w-2xl mx-auto mt-2.5 leading-relaxed font-normal">
      Wybierz obszar, który odpowiada Twojej inwestycji. Przejdź do wyspecjalizowanego katalogu produktowego lub skontaktuj się z doradcą technicznym:
    </p>
  </div>

  <!-- INTERAKTYWNY ROZDZIELACZ STRUMIENIA (Split Gate) -->
  <div
    data-chamber-split
    class="relative z-20 flex-1 grid grid-cols-1 lg:grid-cols-2 gap-5 sm:gap-6 my-auto max-w-7xl mx-auto w-full"
  >

    <!-- ================= OBSZAR 1: RURY PE / RURAPE.PL (AGRO & NAWADNIANIE) ================= -->
    <a
      href="https://rurape.pl"
      target="_blank"
      rel="noopener noreferrer"
      data-card-agro
      class="group relative flex flex-col justify-between p-6 sm:p-8 lg:p-10 rounded-2xl bg-white border-2 border-slate-200 hover:border-emerald-600 shadow-sm hover:shadow-xl transition-all duration-500 overflow-hidden"
    >
      <!-- Subtelny zielony akcent u góry -->
      <div class="absolute top-0 inset-x-0 h-2 bg-emerald-600"></div>

      <!-- Top info karty -->
      <div>
        <div class="flex items-center justify-between font-mono text-xs mb-4">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-emerald-50 text-emerald-800 font-bold uppercase tracking-wider text-[11px] border border-emerald-200">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
            Rolnictwo &middot; Sadownictwo &middot; Nawadnianie
          </span>
          <span class="text-slate-400 font-semibold hidden sm:inline-block">rurape.pl &nearr;</span>
        </div>

        <h2 class="font-display text-2xl sm:text-3xl lg:text-4xl font-extrabold text-[#041A2F] group-hover:text-emerald-700 transition-colors uppercase tracking-tight">
          Rury PE do Nawadniania
        </h2>
        <p class="font-sans text-sm sm:text-base text-slate-600 mt-2.5 leading-relaxed">
          Kompletne magistrale przesyłowe i rury polietylenowe dla gospodarstw rolnych, plantacji jagodowych, sadów oraz instalacji melioracyjnych.
        </p>

        <!-- Praktyczne parametry dla rolnika / wykonawcy -->
        <div class="grid grid-cols-3 gap-2 mt-6 py-4 border-y border-slate-100 font-mono text-xs">
          <div>
            <span class="block text-[10px] text-slate-400 uppercase font-semibold">Materiał</span>
            <span class="text-slate-900 font-bold">PE100 / RC</span>
          </div>
          <div>
            <span class="block text-[10px] text-slate-400 uppercase font-semibold">Średnice</span>
            <span class="text-slate-900 font-bold">DN 16 – 110 mm</span>
          </div>
          <div>
            <span class="block text-[10px] text-slate-400 uppercase font-semibold">Odporność</span>
            <span class="text-emerald-700 font-bold">UV / Grunt</span>
          </div>
        </div>
      </div>

      <!-- Duży, czytelny przycisk konwersji -->
      <div class="mt-6 pt-2 flex items-center justify-between">
        <div class="inline-flex items-center justify-center gap-2 w-full py-3.5 px-5 rounded-xl bg-emerald-700 group-hover:bg-emerald-800 text-white font-semibold text-sm transition-all shadow-sm group-hover:shadow-md">
          <span>Przejdź do katalogu rurape.pl</span>
          <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </div>
      </div>
    </a>

    <!-- ================= OBSZAR 2: POMPY UDOR / SERCEMYJNI.PL (WYSOKIE CIŚNIENIE) ================= -->
    <a
      href="https://sercemyjni.pl"
      target="_blank"
      rel="noopener noreferrer"
      data-card-wash
      class="group relative flex flex-col justify-between p-6 sm:p-8 lg:p-10 rounded-2xl bg-white border-2 border-slate-200 hover:border-rose-600 shadow-sm hover:shadow-xl transition-all duration-500 overflow-hidden"
    >
      <!-- Subtelny czerwony akcent Udor u góry -->
      <div class="absolute top-0 inset-x-0 h-2 bg-rose-600"></div>

      <!-- Top info karty -->
      <div>
        <div class="flex items-center justify-between font-mono text-xs mb-4">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-rose-50 text-rose-800 font-bold uppercase tracking-wider text-[11px] border border-rose-200">
            <span class="w-1.5 h-1.5 rounded-full bg-rose-600"></span>
            Myjnie Samochodowe &middot; Przemysł
          </span>
          <span class="text-slate-400 font-semibold hidden sm:inline-block">sercemyjni.pl &nearr;</span>
        </div>

        <h2 class="font-display text-2xl sm:text-3xl lg:text-4xl font-extrabold text-[#041A2F] group-hover:text-rose-700 transition-colors uppercase tracking-tight">
          Pompy do Myjni (Udor)
        </h2>
        <p class="font-sans text-sm sm:text-base text-slate-600 mt-2.5 leading-relaxed">
          Wysokociśnieniowe pompy nurnikowe włoskiej marki Udor, podzespoły robocze oraz doradztwo serwisowe dla bezdotykowych myjni samochodowych.
        </p>

        <!-- Praktyczne parametry dla właściciela / serwisanta -->
        <div class="grid grid-cols-3 gap-2 mt-6 py-4 border-y border-slate-100 font-mono text-xs">
          <div>
            <span class="block text-[10px] text-slate-400 uppercase font-semibold">Ciśnienie</span>
            <span class="text-slate-900 font-bold">Do 200 bar</span>
          </div>
          <div>
            <span class="block text-[10px] text-slate-400 uppercase font-semibold">Nurniki</span>
            <span class="text-slate-900 font-bold">Ceramiczne</span>
          </div>
          <div>
            <span class="block text-[10px] text-slate-400 uppercase font-semibold">Tryb pracy</span>
            <span class="text-rose-700 font-bold">Heavy Duty 24/7</span>
          </div>
        </div>
      </div>

      <!-- Duży, czytelny przycisk konwersji -->
      <div class="mt-6 pt-2 flex items-center justify-between">
        <div class="inline-flex items-center justify-center gap-2 w-full py-3.5 px-5 rounded-xl bg-rose-700 group-hover:bg-rose-800 text-white font-semibold text-sm transition-all shadow-sm group-hover:shadow-md">
          <span>Przejdź do pomp sercemyjni.pl</span>
          <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </div>
      </div>
    </a>

  </div>

  <!-- Dolny pasek informacyjny z bezpośrednim zaproszeniem do kontaktu -->
  <div class="relative z-10 pt-4 flex flex-col sm:flex-row items-center justify-between border-t border-slate-200 text-xs text-slate-500 font-medium gap-2">
    <div class="flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
      <span>Wsparcie techniczne i wyceny: <strong>Tomasz Kulpa</strong></span>
    </div>
    <a
      href="#about"
      class="hover:text-[#041A2F] transition-colors flex items-center gap-1 font-semibold"
    >
      <span>Dowiedz się więcej o marce TK Flow</span>
      <span>&darr;</span>
    </a>
  </div>
</section>

<script>
  import { gsap } from 'gsap'
  import { DOMLoaded } from '@/ts/events'

  DOMLoaded(() => {
    const cardAgro = document.querySelector('[data-card-agro]')
    const cardWash = document.querySelector('[data-card-wash]')

    if (cardAgro && cardWash) {
      gsap.from([cardAgro, cardWash], {
        y: 30,
        opacity: 0,
        duration: 0.8,
        stagger: 0.15,
        ease: 'power2.out',
      })
    }
  })
</script>