---
// Contact.astro — Typographic Contact Terminal
const currentYear = new Date().getFullYear()
---

<section class="relative w-full pt-32 pb-12 bg-white max-w-[1600px] mx-auto px-6 md:px-12 flex flex-col min-h-[60vh]">
  
  <div class="mb-20">
    <span class="block font-sans text-[10px] uppercase tracking-widest text-nv-blue font-bold mb-8">
      Terminal Bezpośredni &middot; Wyceny
    </span>
    
    <!-- Gigantyczny numer B2B -->
    <a 
      href="tel:+48000000000" 
      class="block font-display font-extrabold text-[12vw] lg:text-[9rem] leading-[0.85] tracking-tightest text-nv-black hover:text-nv-blue transition-colors -ml-1"
    >
      +48 000 000 000
    </a>
    
    <div class="mt-8 lg:mt-12">
      <a 
        href="&#109;&#97;&#105;&#108;&#116;&#111;&#58;&#107;&#111;&#110;&#116;&#97;&#107;&#116;&#64;&#116;&#107;&#102;&#108;&#111;&#119;&#46;&#112;&#108;" 
        class="font-sans text-xl sm:text-2xl font-bold text-nv-black hover:text-nv-blue transition-colors underline underline-offset-8 decoration-nv-border"
      >
        <bdo dir="rtl">lp.wolfkt@tkatnok</bdo>
      </a>
    </div>
  </div>

  <div class="mt-auto border-t border-nv-border">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 py-12 font-sans text-sm">
      
      <div>
        <span class="block text-[10px] text-nv-muted uppercase tracking-widest font-bold mb-4">Rejestr Centrali</span>
        <p class="font-bold text-nv-black">TK Flow Tomasz Kulpa</p>
        <p class="text-nv-muted mt-1">ul. Marcina Kromera 7B/34<br/>85-790 Bydgoszcz</p>
        <p class="text-nv-black font-bold mt-3">NIP: 0000000000</p>
      </div>

      <div>
        <span class="block text-[10px] text-nv-muted uppercase tracking-widest font-bold mb-4">Platformy Zależne</span>
        <div class="flex flex-col gap-3 font-bold uppercase tracking-wide">
          <a href="https://rurape.pl" target="_blank" rel="noopener noreferrer" class="text-nv-black hover:text-[#059669] transition-colors flex items-center justify-between border-b border-nv-border pb-2">
            rurape.pl <span>&nearr;</span>
          </a>
          <a href="https://sercemyjni.pl" target="_blank" rel="noopener noreferrer" class="text-nv-black hover:text-[#DC2626] transition-colors flex items-center justify-between border-b border-nv-border pb-2">
            sercemyjni.pl <span>&nearr;</span>
          </a>
        </div>
      </div>

      <div class="flex flex-col justify-end text-[10px] text-nv-muted uppercase tracking-widest font-bold">
        <p class="mb-2">Inżynieria Przesyłu Cieczy</p>
        <p>&copy; {currentYear} TK FLOW. Wszelkie prawa zastrzeżone.</p>
      </div>

    </div>
  </div>

</section>