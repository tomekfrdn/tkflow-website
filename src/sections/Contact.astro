---
// Contact.astro — Zaufany terminal kontaktowy B2B
const currentYear = new Date().getFullYear()
---

<section
  id="contact"
  data-contact
  class="relative bg-white text-[#0A1A2F] py-20 sm:py-28 px-5 sm:px-8 md:px-12"
>
  <div class="max-w-6xl mx-auto">
    <!-- Header sekcji -->
    <div class="mb-14">
      <div class="flex items-center gap-2 font-mono text-xs tracking-wider uppercase text-[#0098E0] font-bold mb-2">
        <span class="w-2.5 h-2.5 bg-[#0098E0]"></span>
        <span>04 // PUNKT KONTAKTOWY I DANE REJESTROWE</span>
      </div>
      <h2 class="font-display text-3xl sm:text-4xl font-extrabold uppercase text-[#041A2F] tracking-tight">
        Doradztwo Techniczne i Wycena
      </h2>
      <p class="font-sans text-base sm:text-lg text-slate-600 mt-2 max-w-2xl">
        Zadzwoń, wyślij e-mail lub przejdź do dedykowanego serwisu produktowego. Uzyskasz bezpośrednią pomoc techniczną oraz kalkulację kosztów.
      </p>
    </div>

    <!-- Moduł 3-kolumnowy z danymi rejestrowymi i kontaktem -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 pt-8 border-t border-slate-200">
      
      <!-- Kolumna 1: Dane rejestrowe -->
      <div class="p-7 rounded-2xl bg-[#F4F7FA] border border-slate-200 flex flex-col justify-between">
        <div>
          <span class="block font-mono text-[11px] uppercase tracking-wider text-slate-400 font-bold mb-3">
            Dane Firmy
          </span>
          <p class="font-display font-bold text-lg text-[#041A2F] mb-1">TK Flow Tomasz Kulpa</p>
          <p class="text-sm text-slate-600">ul. Marcina Kromera 7B/34</p>
          <p class="text-sm text-slate-600">85-790 Bydgoszcz</p>
        </div>
        <p class="text-sm text-slate-600 mt-6 pt-4 border-t border-slate-200 font-mono">
          NIP: <span class="font-bold text-slate-900">0000000000</span>
        </p>
      </div>

      <!-- Kolumna 2: Kontakt bezpośredni -->
      <div class="p-7 rounded-2xl bg-[#F4F7FA] border border-slate-200 flex flex-col justify-between">
        <div>
          <span class="block font-mono text-[11px] uppercase tracking-wider text-[#0098E0] font-bold mb-3">
            Bezpośredni Kontakt
          </span>
          <div class="mb-4">
            <span class="block text-xs text-slate-500 mb-1 font-mono">Telefon doradcy:</span>
            <a
              href="tel:+48000000000"
              class="font-mono text-xl font-bold text-[#041A2F] hover:text-[#0098E0] transition-colors"
            >
              +48 000 000 000
            </a>
          </div>
          <div>
            <span class="block text-xs text-slate-500 mb-1 font-mono">Adres e-mail:</span>
            <a
              href="&#109;&#97;&#105;&#108;&#116;&#111;&#58;&#107;&#111;&#110;&#116;&#97;&#107;&#116;&#64;&#116;&#107;&#102;&#108;&#111;&#119;&#46;&#112;&#108;"
              class="font-mono text-sm font-bold text-[#041A2F] hover:text-[#0098E0] transition-colors inline-block"
            >
              <bdo dir="rtl">lp.wolfkt@tkatnok</bdo>
            </a>
          </div>
        </div>
        <div class="mt-6 pt-4 border-t border-slate-200 flex items-center gap-2 text-xs text-emerald-700 font-semibold font-mono">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span>Infolinia czynna w godzinach roboczych</span>
        </div>
      </div>

      <!-- Kolumna 3: Serwisy produktowe -->
      <div class="p-7 rounded-2xl bg-[#F4F7FA] border border-slate-200 flex flex-col justify-between">
        <div>
          <span class="block font-mono text-[11px] uppercase tracking-wider text-slate-400 font-bold mb-3">
            Dedykowane Serwisy
          </span>
          <div class="space-y-4 font-mono text-sm">
            <div>
              <span class="block text-xs text-slate-500 uppercase mb-0.5 font-sans">Nawadnianie rolnicze:</span>
              <a
                href="https://rurape.pl"
                target="_blank"
                rel="noopener noreferrer"
                class="font-bold text-emerald-800 hover:text-emerald-900 transition-colors inline-flex items-center gap-1.5"
              >
                <span>rurape.pl</span>
                <span>&nearr;</span>
              </a>
            </div>
            <div>
              <span class="block text-xs text-slate-500 uppercase mb-0.5 font-sans">Pompy do myjni Udor:</span>
              <a
                href="https://sercemyjni.pl"
                target="_blank"
                rel="noopener noreferrer"
                class="font-bold text-rose-800 hover:text-rose-900 transition-colors inline-flex items-center gap-1.5"
              >
                <span>sercemyjni.pl</span>
                <span>&nearr;</span>
              </a>
            </div>
          </div>
        </div>
        <p class="text-xs text-slate-400 mt-6 pt-4 border-t border-slate-200 font-mono">
          Oficjalna dystrybucja &middot; TK Flow
        </p>
      </div>

    </div>

    <!-- Stopka praw autorskich -->
    <div class="mt-16 pt-8 border-t border-slate-200 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs font-mono text-slate-400">
      <p>&copy; {currentYear} TK FLOW Tomasz Kulpa. Wszelkie prawa zastrzeżone.</p>
      <p class="uppercase tracking-wider text-[11px] text-[#041A2F] font-bold">
        Technologie Przesyłu Cieczy
      </p>
    </div>
  </div>
</section>