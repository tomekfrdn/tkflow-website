---
// Contact.astro — Zaufany terminal kontaktowy
const currentYear = new Date().getFullYear()
---

<section
  id="contact"
  class="bg-[#0D0F12] text-white py-24 sm:py-32 px-6 md:px-12"
>
  <div class="max-w-6xl">
    <span class="block text-xs uppercase tracking-[0.25em] text-[#9AA1A9] mb-6 font-medium">
      Kontakt &middot; Bydgoszcz
    </span>

    <h2 class="text-3xl sm:text-5xl font-normal tracking-tight text-white mb-6">
      Doradztwo techniczne i wycena.
    </h2>

    <p class="text-base sm:text-lg text-[#9AA1A9] font-light max-w-2xl mb-16 leading-relaxed">
      Zadzwoń bezpośrednio lub wyślij specyfikację zapotrzebowania drogą mailową.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 pt-12 border-t border-white/10">
      
      <!-- Dane rejestrowe -->
      <div>
        <span class="block text-xs uppercase tracking-widest text-[#9AA1A9] mb-4">
          Rejestr
        </span>
        <p class="text-base text-white font-medium mb-1">TK Flow Tomasz Kulpa</p>
        <p class="text-sm text-[#9AA1A9]">ul. Marcina Kromera 7B/34</p>
        <p class="text-sm text-[#9AA1A9]">85-790 Bydgoszcz</p>
        <p class="text-sm text-[#9AA1A9] mt-3 font-mono">
          NIP: 0000000000
        </p>
      </div>

      <!-- Bezpośredni kontakt -->
      <div>
        <span class="block text-xs uppercase tracking-widest text-[#9AA1A9] mb-4">
          Bezpośrednia Infolinia
        </span>
        <div class="mb-4">
          <a
            href="tel:+48000000000"
            class="text-xl sm:text-2xl text-white hover:text-[#9AA1A9] transition-colors font-normal"
          >
            +48 000 000 000
          </a>
        </div>
        <div>
          <a
            href="&#109;&#97;&#105;&#108;&#116;&#111;&#58;&#107;&#111;&#110;&#116;&#97;&#107;&#116;&#64;&#116;&#107;&#102;&#108;&#111;&#119;&#46;&#112;&#108;"
            class="text-sm text-white hover:text-[#9AA1A9] transition-colors inline-block"
          >
            <bdo dir="rtl">lp.wolfkt@tkatnok</bdo>
          </a>
        </div>
      </div>

      <!-- Bezpośrednie przejścia -->
      <div>
        <span class="block text-xs uppercase tracking-widest text-[#9AA1A9] mb-4">
          Katalogi Produktowe
        </span>
        <ul class="space-y-3 text-sm">
          <li>
            <a
              href="https://rurape.pl"
              target="_blank"
              rel="noopener noreferrer"
              class="text-white hover:text-[#9AA1A9] transition-colors flex items-center justify-between border-b border-white/10 pb-2"
            >
              <span>rurape.pl</span>
              <span>&nearr;</span>
            </a>
          </li>
          <li>
            <a
              href="https://sercemyjni.pl"
              target="_blank"
              rel="noopener noreferrer"
              class="text-white hover:text-[#9AA1A9] transition-colors flex items-center justify-between border-b border-white/10 pb-2"
            >
              <span>sercemyjni.pl</span>
              <span>&nearr;</span>
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Stopka -->
    <div class="mt-24 pt-8 border-t border-white/10 flex flex-col sm:flex-row justify-between items-center text-xs text-[#9AA1A9] tracking-wider uppercase gap-4">
      <p>&copy; {currentYear} TK FLOW Tomasz Kulpa</p>
      <p>Technologie Przesyłu Cieczy</p>
    </div>
  </div>
</section>