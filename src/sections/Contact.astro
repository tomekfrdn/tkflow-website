---
// Contact.astro — Black Monolith Terminal (Ostateczne szlify proporcji i czytelności)
const currentYear = new Date().getFullYear()
---

<section class="w-full bg-tk-dark text-white px-6 md:px-12 py-24 md:py-36 flex flex-col justify-between min-h-[90svh]">
  
  <div class="max-w-[1600px] w-full mx-auto flex-1 flex flex-col">
    
    <div class="mb-auto">
      <span class="block font-mono text-xs uppercase tracking-widest opacity-50 mb-8 font-bold">
        Bezpośredni Punkt Kontaktowy &middot; Doradztwo
      </span>
      
      <!-- GIGANTYCZNY NUMER TELEFONU (Skalowany bezbłędnie w jednej linii) -->
      <a 
        href="tel:+48000000000" 
        class="block font-display font-extrabold text-[clamp(2rem,7.2vw,7.5rem)] leading-[0.85] tracking-tightest hover:opacity-70 kh-transition whitespace-nowrap"
      >
        +48 000 000 000
      </a>
      
      <div class="mt-10">
        <a 
          href="&#109;&#97;&#105;&#108;&#116;&#111;&#58;&#107;&#111;&#110;&#116;&#97;&#107;&#116;&#64;&#116;&#107;&#102;&#108;&#111;&#119;&#46;&#112;&#108;" 
          class="inline-block font-display font-bold text-xl md:text-2xl tracking-tight hover:opacity-70 kh-transition underline underline-offset-8 decoration-white/20"
        >
          <bdo dir="rtl">lp.wolfkt@tkatnok</bdo>
        </a>
      </div>
    </div>

    <!-- Dane Rejestrowe i Linki zidealizowane pod kątem czytelności B2B -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 pt-20 border-t border-white/15 mt-20 font-mono text-xs">
      
      <div>
        <span class="block uppercase tracking-widest opacity-50 font-bold mb-3">Centrala Bydgoszcz</span>
        <p class="font-bold text-sm tracking-wide text-white mb-1">TK Flow Tomasz Kulpa</p>
        <p class="opacity-75 leading-relaxed">ul. Marcina Kromera 7B/34<br/>85-790 Bydgoszcz</p>
        <p class="font-bold mt-3 text-white/90">NIP: 0000000000</p>
      </div>

      <div class="flex flex-col gap-3 font-bold uppercase tracking-widest">
        <span class="block opacity-50 mb-1">Platformy Handlowe</span>
        <a href="https://rurape.pl" target="_blank" rel="noopener noreferrer" class="hover:opacity-70 kh-transition flex items-center justify-between border-b border-white/10 pb-2 text-emerald-400">
          rurape.pl <span>&nearr;</span>
        </a>
        <a href="https://sercemyjni.pl" target="_blank" rel="noopener noreferrer" class="hover:opacity-70 kh-transition flex items-center justify-between border-b border-white/10 pb-2 text-rose-300">
          sercemyjni.pl <span>&nearr;</span>
        </a>
      </div>

      <div class="flex flex-col justify-end text-[10px] opacity-40 uppercase tracking-widest font-bold">
        <p>&copy; {currentYear} TK FLOW. Wszelkie prawa zastrzeżone.</p>
        <p class="mt-1">Technologie Przesyłu Cieczy</p>
      </div>

    </div>

  </div>
</section>