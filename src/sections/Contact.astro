---
// Contact.astro — Zaufany terminal kontaktowy B2B
const currentYear = new Date().getFullYear()
---

<section
  id="contact"
  data-contact
  class="relative bg-white text-[#0F172A] py-20 sm:py-28 px-5 sm:px-8 md:px-12"
>
  <div class="max-w-6xl mx-auto">
    <!-- Header sekcji -->
    <div class="mb-12">
      <span class="font-mono text-xs tracking-wider uppercase text-[#00A3E0] font-bold block mb-2">
        Kontakt &middot; Wyceny &middot; Doradztwo
      </span>
      <h2 class="font-display text-3xl sm:text-4xl font-extrabold uppercase text-[#041A2F] tracking-tight">
        Skontaktuj się w Sprawie Doboru
      </h2>
      <p class="font-sans text-base sm:text-lg text-slate-600 mt-2 max-w-2xl">
        Zadzwoń lub wyślij zapytanie e-mail. Uzyskasz bezpośrednią pomoc techniczną oraz wycenę komponentów.
      </p>
    </div>

    <!-- Moduł 3-kolumnowy z danymi rejestrowymi i kontaktem -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 pt-8 border-t border-slate-200">
      
      <!-- Kolumna 1: Dane rejestrowe -->
      <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 flex flex-col justify-between">
        <div>
          <span class="block font-mono text-[11px] uppercase tracking-wider text-slate-400 font-bold mb-3">
            Dane Firmy
          </span>
          <p class="font-display font-bold text-lg text-[#041A2F] mb-1">TK Flow Tomasz Kulpa</p>
          <p class="text-sm text-slate-600">ul. Marcina Kromera 7B/34</p>
          <p class="text-sm text-slate-600">85-790 Bydgoszcz</p>
        </div>
        <p class="text-sm text-slate-600 mt-6 pt-4 border-t border-slate-200 font-mono">
          NIP: <span class="font-bold text-slate-900">0000000000</span>
        </p>
      </div>

      <!-- Kolumna 2: Kontakt telefoniczny i mailowy -->
      <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 flex flex-col justify-between">
        <div>
          <span class="block font-mono text-[11px] uppercase tracking-wider text-[#00A3E0] font-bold mb-3">
            Bezpośredni Kontakt
          </span>
          <div class="mb-4">
            <span class="block text-xs text-slate-500 mb-0.5">Telefon doradcy:</span>
            <a
              href="tel:+48000000000"
              class="font-mono text-xl font-bold text-[#041A2F] hover:text-[#00A3E0] transition-colors"
            >
              +48 000 000 000
            </a>
          </div>
          <div>
            <span class="block text-xs text-slate-500 mb-0.5">Adres e-mail:</span>
            <a
              href="&#109;&#97;&#105;&#108;&#116;&#111;&#58;&#107;&#111;&#110;&#116;&#97;&#107;&#116;&#64;&#116;&#107;&#102;&#108;&#111;&#119;&#46;&#112;&#108;"
              class="font-mono text-sm font-semibold text-[#041A2F] hover:text-[#00A3E0] transition-colors inline-block"
            >
              <bdo dir="rtl">lp.wolfkt@tkatnok</bdo>
            </a>
          </div>
        </div>
        <div class="mt-6 pt-4 border-t border-slate-200 flex items-center gap-2 text-xs text-emerald-700 font-semibold">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span>Dostępny w godzinach roboczych</span>
        </div>
      </div>

      <!-- Kolumna 3: Szybkie przejścia do serwisów -->
      <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 flex flex-col justify-between">
        <div>
          <span class="block font-mono text-[11px] uppercase tracking-wider text-slate-400 font-bold mb-3">
            Serwisy Produktowe
          </span>
          <div class="space-y-4 font-mono text-sm">
            <div>
              <span class="block text-xs text-slate-500 uppercase mb-0.5 font-sans">Rury do nawadniania:</span>
              <a
                href="https://rurape.pl"
                target="_blank"
                rel="noopener noreferrer"
                class="font-semibold text-emerald-700 hover:text-emerald-800 transition-colors inline-flex items-center gap-1.5"
              >
                <span>rurape.pl</span>
                <span>&nearr;</span>
              </a>
            </div>
            <div>
              <span class="block text-xs text-slate-500 uppercase mb-0.5 font-sans">Pompy do myjni Udor:</span>
              <a
                href="https://sercemyjni.pl"
                target="_blank"
                rel="noopener noreferrer"
                class="font-semibold text-rose-700 hover:text-rose-800 transition-colors inline-flex items-center gap-1.5"
              >
                <span>sercemyjni.pl</span>
                <span>&nearr;</span>
              </a>
            </div>
          </div>
        </div>
        <p class="text-xs text-slate-400 mt-6 pt-4 border-t border-slate-200">
          Oficjalna dystrybucja i zaopatrzenie
        </p>
      </div>

    </div>

    <!-- Stopka praw autorskich -->
    <div class="mt-16 pt-8 border-t border-slate-200 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs font-mono text-slate-400">
      <p>&copy; {currentYear} TK FLOW Tomasz Kulpa. Wszelkie prawa zastrzeżone.</p>
      <p class="uppercase tracking-wider text-[11px] text-[#041A2F] font-semibold">
        Technologie Przesyłu Cieczy
      </p>
    </div>
  </div>
</section>