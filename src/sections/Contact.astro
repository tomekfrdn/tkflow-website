---
// Contact.astro — Zaufany terminal kontaktowy
const currentYear = new Date().getFullYear()
---

<section
  id="contact"
  class="relative bg-white text-[#0B1523] py-20 sm:py-28 px-5 sm:px-8 md:px-12"
>
  <div class="max-w-6xl mx-auto">
    <div class="mb-14">
      <h2 class="font-extrabold text-3xl sm:text-4xl uppercase text-[#0B1523] tracking-tight">
        Transparentne Dane i Kontakt
      </h2>
      <p class="font-sans text-base sm:text-lg text-slate-600 mt-3 max-w-2xl">
        Żadnych ukrytych formularzy. Zadzwoń bezpośrednio do inżyniera prowadzącego, aby uzyskać wycenę i dobrać komponenty.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 pt-8 border-t border-slate-200">
      
      <!-- Adres i Rejestr -->
      <div class="p-8 rounded-2xl bg-[#F8FAFC] border border-slate-200 flex flex-col justify-between">
        <div>
          <span class="block font-mono text-[10px] uppercase tracking-widest text-slate-400 font-bold mb-4">
            Dane Rejestrowe
          </span>
          <p class="font-bold text-lg text-[#0B1523] mb-1">TK Flow Tomasz Kulpa</p>
          <p class="text-sm text-slate-600">ul. Marcina Kromera 7B/34</p>
          <p class="text-sm text-slate-600">85-790 Bydgoszcz</p>
        </div>
        <p class="text-sm text-slate-600 mt-6 pt-4 border-t border-slate-200 font-mono">
          NIP: <span class="font-bold text-[#0B1523]">0000000000</span>
        </p>
      </div>

      <!-- Kontakt Bezpośredni -->
      <div class="p-8 rounded-2xl bg-[#F8FAFC] border border-slate-200 flex flex-col justify-between">
        <div>
          <span class="block font-mono text-[10px] uppercase tracking-widest text-[#0066CC] font-bold mb-4">
            Infolinia Techniczna
          </span>
          <div class="mb-5">
            <span class="block text-xs text-slate-500 mb-1 font-sans">Rozmowa i dobór:</span>
            <a
              href="tel:+48000000000"
              class="font-mono text-2xl font-bold text-[#0B1523] hover:text-[#0066CC] transition-colors tracking-tight"
            >
              +48 000 000 000
            </a>
          </div>
          <div>
            <span class="block text-xs text-slate-500 mb-1 font-sans">Zapytania ofertowe:</span>
            <a
              href="&#109;&#97;&#105;&#108;&#116;&#111;&#58;&#107;&#111;&#110;&#116;&#97;&#107;&#116;&#64;&#116;&#107;&#102;&#108;&#111;&#119;&#46;&#112;&#108;"
              class="font-mono text-sm font-bold text-[#0B1523] hover:text-[#0066CC] transition-colors inline-block"
            >
              <bdo dir="rtl">lp.wolfkt@tkatnok</bdo>
            </a>
          </div>
        </div>
      </div>

      <!-- Szybkie linki -->
      <div class="p-8 rounded-2xl bg-[#F8FAFC] border border-slate-200 flex flex-col justify-between">
        <div>
          <span class="block font-mono text-[10px] uppercase tracking-widest text-slate-400 font-bold mb-4">
            Przejdź do oferty
          </span>
          <div class="space-y-4">
            <div>
              <a
                href="https://rurape.pl"
                target="_blank"
                rel="noopener noreferrer"
                class="font-bold text-emerald-700 hover:text-emerald-800 transition-colors inline-flex items-center gap-1.5"
              >
                <span>Nawadnianie: rurape.pl</span>
                <span class="text-xs">&nearr;</span>
              </a>
            </div>
            <div>
              <a
                href="https://sercemyjni.pl"
                target="_blank"
                rel="noopener noreferrer"
                class="font-bold text-[#DC2626] hover:text-[#B91C1C] transition-colors inline-flex items-center gap-1.5"
              >
                <span>Pompy: sercemyjni.pl</span>
                <span class="text-xs">&nearr;</span>
              </a>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- Stopka -->
    <div class="mt-12 pt-6 border-t border-slate-200 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs font-mono text-slate-500">
      <p>&copy; {currentYear} TK FLOW Tomasz Kulpa. Wszelkie prawa zastrzeżone.</p>
      <p class="uppercase tracking-widest text-[10px] text-[#0B1523] font-bold">
        Technologie Przesyłu Wody
      </p>
    </div>
  </div>
</section>