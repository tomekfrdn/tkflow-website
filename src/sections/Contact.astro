---
// Contact.astro — The Typographic Terminal
const currentYear = new Date().getFullYear()
---

<section class="relative w-full pt-32 pb-12 bg-white max-w-[1600px] mx-auto flex flex-col justify-between min-h-[70vh]">
  
  <div class="px-6 md:px-12 mb-16">
    <span class="block font-mono text-[10px] uppercase tracking-[0.2em] text-tk-muted font-bold mb-8">
      Szybki Punkt Poboru &middot; Wyceny
    </span>
    
    <!-- Gigantyczny numer telefonu (Hero Typography) -->
    <a 
      href="tel:+48000000000" 
      class="block font-extrabold text-[12vw] md:text-[8vw] xl:text-[7rem] leading-none tracking-tighter text-tk-black hover:text-tk-water transition-colors"
    >
      +48 000 000 000
    </a>
    
    <div class="mt-8">
      <a 
        href="&#109;&#97;&#105;&#108;&#116;&#111;&#58;&#107;&#111;&#110;&#116;&#97;&#107;&#116;&#64;&#116;&#107;&#102;&#108;&#111;&#119;&#46;&#112;&#108;" 
        class="font-mono text-lg sm:text-xl font-bold text-tk-black hover:text-tk-water transition-colors underline underline-offset-8 decoration-tk-border"
      >
        <bdo dir="rtl">lp.wolfkt@tkatnok</bdo>
      </a>
    </div>
  </div>

  <div class="px-6 md:px-12 mt-auto">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 py-12 border-t border-tk-border font-mono text-xs">
      
      <!-- Kolumna 1 -->
      <div>
        <span class="block text-tk-muted uppercase tracking-widest font-bold mb-4">Centrala</span>
        <p class="text-tk-black font-bold uppercase mb-1">TK Flow Tomasz Kulpa</p>
        <p class="text-tk-muted">ul. Marcina Kromera 7B/34</p>
        <p class="text-tk-muted">85-790 Bydgoszcz</p>
      </div>

      <!-- Kolumna 2 -->
      <div>
        <span class="block text-tk-muted uppercase tracking-widest font-bold mb-4">Rejestr</span>
        <p class="text-tk-black font-bold">NIP: 0000000000</p>
        <p class="text-tk-muted mt-2">Dystrybucja B2B Cała Polska</p>
      </div>

      <!-- Kolumna 3 -->
      <div class="flex flex-col gap-3 font-bold uppercase tracking-widest">
        <span class="block text-tk-muted mb-1">Platformy</span>
        <a href="https://rurape.pl" target="_blank" rel="noopener noreferrer" class="text-tk-black hover:text-tk-agro transition-colors flex items-center justify-between border-b border-tk-border pb-1">
          rurape.pl <span>&nearr;</span>
        </a>
        <a href="https://sercemyjni.pl" target="_blank" rel="noopener noreferrer" class="text-tk-black hover:text-tk-wash transition-colors flex items-center justify-between border-b border-tk-border pb-1">
          sercemyjni.pl <span>&nearr;</span>
        </a>
      </div>

    </div>

    <!-- Stopka ostateczna -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center pt-8 border-t border-tk-border font-mono text-[10px] text-tk-muted uppercase tracking-[0.2em] font-bold gap-4">
      <p>&copy; {currentYear} TK FLOW. Wszystkie prawa zastrzeżone.</p>
      <p class="text-tk-black">Architektura Przesyłu Cieczy</p>
    </div>
  </div>

</section>