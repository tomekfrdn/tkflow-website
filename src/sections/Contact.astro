<section class="w-full bg-tk-dark text-white px-6 md:px-12 py-16 lg:py-24 flex flex-col min-h-0 lg:min-h-[90svh]">
  
  <div class="max-w-[1600px] w-full mx-auto flex-1 flex flex-col justify-between">
    
    <div class="pb-16 lg:pb-24">
      <span class="block font-mono text-xs uppercase tracking-widest opacity-50 mb-6 font-bold">
        Bezpośredni kontakt &middot; Doradztwo
      </span>
      
      <a 
        href="&#116;&#101;&#108;&#58;&#43;&#52;&#56;&#52;&#53;&#53;&#53;&#56;&#48;&#56;&#49;&#49;" 
        class="block font-display font-extrabold text-[clamp(2rem,7.5vw,7.5rem)] leading-[0.85] tracking-tightest hover:opacity-70 kh-transition whitespace-nowrap mb-6"
