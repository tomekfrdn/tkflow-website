---
// Contact.astro — Black Monolith Footer
const currentYear = new Date().getFullYear()
---

<section class="w-full bg-kh-black text-white px-6 md:px-12 py-24 md:py-32 flex flex-col justify-between min-h-[90svh]">
  
  <div class="max-w-[1800px] w-full mx-auto flex-1 flex flex-col">
    
    <div class="mb-auto">
      <span class="block font-bold text-sm uppercase tracking-widest opacity-60 mb-8">
        Bezpośredni Punkt Kontaktowy
      </span>
      
      <!-- GIGANTYCZNY TELEFON -->
      <a 
        href="tel:+48000000000" 
        class="block font-extrabold text-[12vw] md:text-[10vw] leading-[0.85] tracking-tighter hover:opacity-70 kh-transition"
      >
        +48 000 000 000
      </a>
      
      <a 
        href="&#109;&#97;&#105;&#108;&#116;&#111;&#58;&#107;&#111;&#110;&#116;&#97;&#107;&#116;&#64;&#116;&#107;&#102;&#108;&#111;&#119;&#46;&#112;&#108;" 
        class="inline-block font-bold text-3xl md:text-5xl tracking-tighter mt-12 hover:opacity-70 kh-transition"
      >
        <bdo dir="rtl">lp.wolfkt@tkatnok</bdo>
      </a>
    </div>

    <!-- Dane Rejestrowe i Linki w prostej siatce -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 pt-24 border-t-2 border-white/20 mt-24 font-bold text-lg md:text-xl">
      
      <div class="flex flex-col gap-1 opacity-80">
        <span>TK Flow Tomasz Kulpa</span>
        <span>ul. Marcina Kromera 7B/34</span>
        <span>85-790 Bydgoszcz</span>
      </div>

      <div class="flex flex-col gap-1 opacity-80">
        <span>NIP: 0000000000</span>
        <span>Dystrybucja B2B Cała Polska</span>
      </div>

      <div class="flex flex-col gap-4">
        <a href="https://rurape.pl" target="_blank" class="hover:opacity-70 kh-transition flex items-center justify-between">
          rurape.pl <span>&nearr;</span>
        </a>
        <a href="https://sercemyjni.pl" target="_blank" class="hover:opacity-70 kh-transition flex items-center justify-between">
          sercemyjni.pl <span>&nearr;</span>
        </a>
      </div>

    </div>

    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-end mt-24 font-bold text-xs uppercase tracking-widest opacity-40">
      <span>&copy; {currentYear} TK FLOW</span>
      <span class="mt-4 sm:mt-0">Architektura Przesyłu Cieczy</span>
    </div>

  </div>
</section>