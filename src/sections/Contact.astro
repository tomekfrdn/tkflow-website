---
const currentYear = new Date().getFullYear()
---

<section
  data-contact
  class="bg-light-blue text-steel-blue py-28 md:py-36 lg:py-44 px-6 sm:px-8 border-t border-white/5"
>
  <div class="flex flex-col gap-16 max-w-5xl mx-auto">
    <!-- Nagłówek sekcji z poszerzoną przestrzenią -->
    <div class="flex flex-col gap-5">
      <h2 class="text-white text-3xl sm:text-4xl lg:text-5xl font-semibold tracking-tight leading-[1.15]">
        Doradztwo techniczne i wycena
      </h2>
      <p class="text-base sm:text-lg lg:text-xl text-white/70 max-w-3xl leading-relaxed">
        Zadzwoń, wyślij e-mail lub przejdź do dedykowanego serwisu produktowego.
      </p>
    </div>

    <!-- Moduł danych firmowych i kontaktu w układzie 3-kolumnowym -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 lg:gap-12 pt-12 border-t border-white/10">
      
      <!-- Kolumna 1: Dane rejestrowe -->
      <div class="flex flex-col gap-3">
        <span class="text-xs uppercase tracking-[0.25em] text-white/50 font-medium">
          Dane rejestrowe
        </span>
        <div class="text-sm leading-relaxed">
          <p class="text-white font-semibold text-base mb-1">TK Flow Tomasz Kulpa</p>
          <p class="text-white/70">ul. Przykładowa 12/34</p>
          <p class="text-white/70">00-000 Miejscowość</p>
          <p class="text-white/70 mt-1">
            NIP: <span class="text-white font-mono tracking-wide">0000000000</span>
          </p>
        </div>
      </div>

      <!-- Kolumna 2: Kontakt bezpośredni -->
      <div class="flex flex-col gap-3">
        <span class="text-xs uppercase tracking-[0.25em] text-white/50 font-medium">
          Kontakt bezpośredni
        </span>
        <div class="flex flex-col gap-4 text-sm">
          <div>
            <span class="block text-xs text-white/40 mb-0.5">Telefon:</span>
            <a
              href="tel:+48000000000"
              class="text-white hover:text-white/80 transition-colors font-medium text-lg tracking-wide font-mono"
            >
              +48 000 000 000
            </a>
          </div>
          <div>
            <span class="block text-xs text-white/40 mb-0.5">E-mail:</span>
            <a
              href="mailto:kontakt@tkflow.pl"
              class="text-white hover:text-white/80 transition-colors font-medium text-base tracking-wide"
            >
              kontakt@tkflow.pl
            </a>
          </div>
        </div>
      </div>

      <!-- Kolumna 3: Strony produktowe -->
      <div class="flex flex-col gap-3">
        <span class="text-xs uppercase tracking-[0.25em] text-white/50 font-medium">
          Strony produktowe
        </span>
        <div class="flex flex-col gap-4 text-sm">
          <div>
            <span class="block text-xs text-white/40 mb-0.5">Pompy do myjni:</span>
            <a
              href="https://sercemyjni.pl"
              target="_blank"
              rel="noopener noreferrer"
              class="text-white hover:text-white/80 transition-colors font-medium text-base tracking-wide underline decoration-white/20 underline-offset-4 hover:decoration-white"
            >
              sercemyjni.pl
            </a>
          </div>
          <div>
            <span class="block text-xs text-white/40 mb-0.5">Rury PE do nawadniania:</span>
            <a
              href="https://rurape.pl"
              target="_blank"
              rel="noopener noreferrer"
              class="text-white hover:text-white/80 transition-colors font-medium text-base tracking-wide underline decoration-white/20 underline-offset-4 hover:decoration-white"
            >
              rurape.pl
            </a>
          </div>
        </div>
      </div>

    </div>

    <!-- Stopka praw autorskich -->
    <div class="pt-8 border-t border-white/5 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-white/40">
      <p>{currentYear} TK Flow Tomasz Kulpa</p>
      <p class="tracking-widest uppercase text-[10px] text-white/30">Technologie przesyłu cieczy</p>
    </div>
  </div>
</section>

<script>
  import { DOMLoaded } from '../ts/events'
  import { fadeIn } from '../ts/animations'

  DOMLoaded(() => {
    const trigger = document.querySelector('[data-contact]') as HTMLElement
    const target = trigger?.querySelector(':scope > div') as HTMLElement

    if (trigger && target) {
      fadeIn(trigger, target)
    }
  })
</script>