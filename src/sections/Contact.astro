---
// Contact.astro — Clear, Institutional Contact Information
const currentYear = new Date().getFullYear()
---

<section id="contact" class="bg-white pt-24 pb-12 px-6 md:px-12 border-t border-black/10">
  <div class="max-w-6xl mx-auto">
    
    <div class="mb-20">
      <h2 class="text-4xl sm:text-6xl font-normal tracking-tight text-black mb-6">
        Skontaktuj się w sprawie doboru i wyceny.
      </h2>
      <a href="tel:+48000000000" class="inline-block text-3xl sm:text-5xl font-bold text-black hover:text-black/60 transition-colors">
        +48 000 000 000
      </a>
      <div class="mt-6">
        <a href="&#109;&#97;&#105;&#108;&#116;&#111;&#58;&#107;&#111;&#110;&#116;&#97;&#107;&#116;&#64;&#116;&#107;&#102;&#108;&#111;&#119;&#46;&#112;&#108;" class="text-xl text-[#717171] hover:text-black transition-colors underline underline-offset-8">
          <bdo dir="rtl">lp.wolfkt@tkatnok</bdo>
        </a>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 border-t border-black/10 pt-12">
      <div>
        <span class="block text-[10px] tracking-widest uppercase text-[#717171] font-bold mb-4">Dane Rejestrowe</span>
        <p class="text-black font-bold">TK Flow Tomasz Kulpa</p>
        <p class="text-[#717171]">ul. Marcina Kromera 7B/34</p>
        <p class="text-[#717171]">85-790 Bydgoszcz</p>
        <p class="text-black font-medium mt-2">NIP: 0000000000</p>
      </div>

      <div>
        <span class="block text-[10px] tracking-widest uppercase text-[#717171] font-bold mb-4">Nasze Marki</span>
        <div class="flex flex-col gap-2">
          <a href="https://rurape.pl" target="_blank" rel="noopener noreferrer" class="text-black font-bold hover:opacity-60 transition-opacity">rurape.pl &nearr;</a>
          <a href="https://sercemyjni.pl" target="_blank" rel="noopener noreferrer" class="text-black font-bold hover:opacity-60 transition-opacity">sercemyjni.pl &nearr;</a>
        </div>
      </div>
    </div>

    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center border-t border-black/10 mt-20 pt-8 text-xs text-[#717171] font-medium uppercase tracking-wider">
      <p>&copy; {currentYear} TK FLOW. Wszelkie prawa zastrzeżone.</p>
      <p class="mt-2 sm:mt-0">Design inspirowany estetyką industrialną.</p>
    </div>

  </div>
</section>