---
// Contact.astro — Clear, Institutional Contact Information (Huge Typography)
const currentYear = new Date().getFullYear()
---

<section id="contact" class="bg-white pt-24 pb-12 px-6 md:px-12 border-t border-nv-border">
  <div class="max-w-6xl mx-auto">
    
    <!-- Ogromny telefon -->
    <div class="mb-20 lg:mb-32">
      <h2 class="text-2xl sm:text-3xl font-medium tracking-tight text-nv-muted mb-6">
        Skontaktuj się w sprawie doboru i wyceny.
      </h2>
      <a href="tel:+48000000000" class="block text-5xl sm:text-7xl lg:text-[7rem] font-extrabold tracking-tighter text-nv-graphite hover:text-black transition-colors leading-none mb-6">
        +48 000 000 000
      </a>
      <a href="&#109;&#97;&#105;&#108;&#116;&#111;&#58;&#107;&#111;&#110;&#116;&#97;&#107;&#116;&#64;&#116;&#107;&#102;&#108;&#111;&#119;&#46;&#112;&#108;" class="text-xl sm:text-2xl font-bold text-nv-graphite hover:text-nv-muted transition-colors underline underline-offset-8">
        <bdo dir="rtl">lp.wolfkt@tkatnok</bdo>
      </a>
    </div>

    <!-- Dane w siatce -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12 border-t border-nv-border pt-12">
      <div>
        <span class="block text-[10px] tracking-widest uppercase text-nv-muted font-bold mb-4">Dane Rejestrowe</span>
        <p class="text-nv-graphite font-bold text-lg mb-1">TK Flow Tomasz Kulpa</p>
        <p class="text-nv-muted">ul. Marcina Kromera 7B/34</p>
        <p class="text-nv-muted">85-790 Bydgoszcz</p>
        <p class="text-nv-graphite font-mono font-bold mt-4">NIP: 0000000000</p>
      </div>

      <div>
        <span class="block text-[10px] tracking-widest uppercase text-nv-muted font-bold mb-4">Dedykowane Platformy</span>
        <div class="flex flex-col gap-3">
          <a href="https://rurape.pl" target="_blank" rel="noopener noreferrer" class="text-nv-graphite font-bold text-lg hover:text-nv-muted transition-colors flex items-center justify-between border-b border-nv-border pb-2">
            Nawadnianie: rurape.pl <span class="text-sm font-normal">&nearr;</span>
          </a>
          <a href="https://sercemyjni.pl" target="_blank" rel="noopener noreferrer" class="text-nv-graphite font-bold text-lg hover:text-nv-muted transition-colors flex items-center justify-between border-b border-nv-border pb-2">
            Pompy: sercemyjni.pl <span class="text-sm font-normal">&nearr;</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Stopka -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center border-t border-nv-border mt-20 pt-8 text-xs text-nv-muted font-bold uppercase tracking-widest">
      <p>&copy; {currentYear} TK FLOW. Wszelkie prawa zastrzeżone.</p>
      <p class="mt-2 sm:mt-0 text-nv-graphite">Inżynieria Przesyłu Wody</p>
    </div>

  </div>
</section>