---
// About.astro
---

<section
  id="about"
  data-about
  class="relative bg-[#030C15] text-[#8FAEC4] py-32 md:py-44 px-6 md:px-12 border-t border-white/5 overflow-hidden"
>
  <!-- Tło siatki -->
  <div
    class="absolute inset-0 opacity-[0.03] pointer-events-none"
    style="background-image: linear-gradient(#fff 1px, transparent 1px), linear-gradient(90deg, #fff 1px, transparent 1px); background-size: 80px 80px;"
  ></div>

  <div class="relative max-w-6xl mx-auto">
    <!-- Etykieta sekcji HUD -->
    <div class="flex items-center gap-3 font-mono text-[10px] md:text-xs tracking-[0.25em] uppercase text-[#00A3E0] mb-12">
      <span class="w-1.5 h-1.5 bg-[#00A3E0]"></span>
      <span>02 // DORADZTWO TECHNICZNE I PARTNERSTWO</span>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      <!-- Główny tekst manifestu -->
      <div class="lg:col-span-8">
        <h2
          data-about-text
          class="font-display text-2xl sm:text-3xl md:text-4xl lg:text-[2.6rem] font-medium leading-[1.35] tracking-tight text-white/90"
        >
          Nazywam się <span class="text-white font-bold underline decoration-[#00A3E0]/40 underline-offset-8">Tomasz Kulpa</span>. Wspieram inwestorów i&nbsp;wykonawców w&nbsp;doborze oraz zaopatrzeniu w&nbsp;kluczowe komponenty do&nbsp;przesyłu wody i&nbsp;systemów wysokociśnieniowych.
          <br /><br />
          W&nbsp;TK Flow łączę zaplecze czołowych producentów z&nbsp;partnerskim doradztwem. Dbam o&nbsp;to, by&nbsp;instalacje pracowały bezawaryjnie, oszczędzając Twój czas i&nbsp;pieniądze.
        </h2>
      </div>

      <!-- Wizytówka inżyniera / Sygnatura -->
      <div class="lg:col-span-4 border-l border-white/10 lg:pl-10 pt-4 flex flex-col gap-6">
        <div class="relative w-24 h-24 rounded-2xl overflow-hidden ring-1 ring-white/20 bg-[#041A2F] shadow-2xl">
          <img
            src="/images/tomasz-kulpa-tk-flow.jpg"
            alt="Tomasz Kulpa"
            width="96"
            height="96"
            class="w-full h-full object-cover filter grayscale contrast-110 hover:grayscale-0 transition-all duration-500"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#030C15]/60 to-transparent"></div>
        </div>

        <div>
          <span class="block font-display text-xl font-bold tracking-tight text-white">
            Tomasz Kulpa
          </span>
          <span class="block font-mono text-xs tracking-widest uppercase text-[#00A3E0] mt-1">
            Założyciel & Doradca Techniczny
          </span>
          <p class="font-sans text-xs text-[#8FAEC4]/70 mt-3 leading-relaxed">
            Praktyczna znajomość fizyki instalacji ciśnieniowych oraz armatury przesyłowej dedykowanej dla wymagających środowisk roboczych.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  import { DOMLoaded } from '@/ts/events'

  DOMLoaded(() => {
    gsap.registerPlugin(ScrollTrigger)
    const text = document.querySelector('[data-about-text]') as HTMLElement

    if (text) {
      gsap.fromTo(
        text,
        { opacity: 0.2, y: 30 },
        {
          opacity: 1,
          y: 0,
          duration: 1.2,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: text,
            start: 'top 80%',
            toggleActions: 'play none none reverse',
          },
        }
      )
    }
  })
</script>