---
import TextReveal from '@/components/TextReveal.astro'
---

<section
  data-about
  class="bg-light-blue text-steel-blue py-24 md:py-32 lg:py-40 px-6 sm:px-8"
>
  <div class="mx-auto max-w-3xl text-center">
    <TextReveal
      class="text-xl sm:text-2xl lg:text-3xl font-sans font-medium leading-relaxed sm:leading-relaxed lg:leading-relaxed"
      color="bg-gradient-to-r from-white to-white text-white/50"
    >
      Nazywam się Tomasz Kulpa. Wspieram inwestorów i wykonawców w doborze oraz zaopatrzeniu w kluczowe komponenty do przesyłu wody i systemów wysokociśnieniowych.
      <br /><br />
      W TK Flow łączę zaplecze czołowych producentów z partnerskim doradztwem. Dbam o to, by instalacje pracowały bezawaryjnie, oszczędzając Twój czas i pieniądze.
    </TextReveal>
  </div>
</section>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  import { DOMLoaded } from '../ts/events'

  DOMLoaded(() => {
    gsap.registerPlugin(ScrollTrigger)

    const trigger = document.querySelector('[data-about]') as HTMLElement
    const target = trigger?.querySelector('p') as HTMLElement

    if (trigger && target) {
      // Płynne, responsywne wygaszanie tekstu powiązane z wysokością ekranu
      gsap.to(target, {
        opacity: 0.15,
        scrollTrigger: {
          trigger: target, // Śledzimy bezpośrednio blok tekstu
          start: 'top 30%',
          end: () => `+=${window.innerHeight * 0.75}`, // Skrócony dystans dopasowany do mniejszej wysokości bloku
          scrub: 1.2,
          invalidateOnRefresh: true, // Przelicza dystans po zmianie rozmiaru okna/ekranu
        },
        ease: 'none',
      })
    }
  })
</script>