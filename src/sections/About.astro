---
import TextReveal from '@/components/TextReveal.astro'
---

<section
  data-about
  class="bg-light-blue text-steel-blue py-24 md:py-32 lg:py-40 px-6 sm:px-8"
>
  <div class="mx-auto max-w-3xl text-left">
    <!-- Główny tekst z efektem TextReveal i dedykowanym wygaszaniem -->
    <TextReveal
      class="text-xl sm:text-2xl lg:text-3xl font-sans font-medium leading-[1.75] sm:leading-[1.8] tracking-normal"
      color="bg-gradient-to-r from-white to-white text-white/50"
    >
      Nazywam się Tomasz Kulpa. Wspieram inwestorów i&nbsp;wykonawców w&nbsp;doborze oraz zaopatrzeniu w&nbsp;kluczowe komponenty do&nbsp;przesyłu wody i&nbsp;systemów wysokociśnieniowych.
      <br /><br />
      W&nbsp;TK Flow łączę zaplecze czołowych producentów z&nbsp;partnerskim doradztwem. Dbam o&nbsp;to, by&nbsp;instalacje pracowały bezawaryjnie, oszczędzając Twój czas i&nbsp;pieniądze.
    </TextReveal>

    <!-- Wizualna sygnatura (Author Byline) – poza zasięgiem wygaszania GSAP -->
    <div class="mt-12 sm:mt-16 pt-8 border-t border-white/10 flex items-center gap-4 sm:gap-5">
      <!-- Okrągły awatar w estetyce Industrial Luxury -->
      <div class="relative shrink-0">
        <img
          src="/images/tomasz-kulpa-tk-flow.jpg"
          alt="Tomasz Kulpa - TK Flow"
          width="56"
          height="56"
          class="w-12 h-12 sm:w-14 sm:h-14 rounded-full object-cover ring-2 ring-white/20 shadow-lg"
        />
        <!-- Dyskretny punkt świetlny/status obecności spójny z przyciskiem w nagłówku -->
        <span class="absolute bottom-0 right-0 w-3 h-3 rounded-full bg-emerald-400 ring-2 ring-light-blue" aria-hidden="true"></span>
      </div>

      <!-- Podpis: Imie, nazwisko i funkcja -->
      <div class="flex flex-col justify-center">
        <span class="font-sans text-base sm:text-lg font-semibold tracking-tight text-white leading-snug">
          Tomasz Kulpa
        </span>
        <span class="font-mono text-[11px] sm:text-xs tracking-wider uppercase text-white/60 mt-0.5">
          Założyciel TK Flow & Doradca Techniczny
        </span>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  import { DOMLoaded } from '../ts/events'

  DOMLoaded(() => {
    gsap.registerPlugin(ScrollTrigger)

    const trigger = document.querySelector('[data-about]') as HTMLElement
    // Celujemy precyzyjnie w paragraf wewnątrz TextReveal – sygnatura z podpisem pozostaje nietknięta
    const target = trigger?.querySelector('p') as HTMLElement

    if (trigger && target) {
      gsap.to(target, {
        opacity: 0.15,
        scrollTrigger: {
          trigger: target,
          start: 'top 30%',
          end: () => `+=${window.innerHeight * 0.75}`,
          scrub: 1.2,
          invalidateOnRefresh: true,
        },
        ease: 'none',
      })
    }
  })
</script>