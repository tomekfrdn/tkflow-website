---
import TextReveal from '@/components/TextReveal.astro'
// Importujemy plik bezpośrednio z katalogu public/ lub assets/
import authorPhoto from '/public/tomasz-kulpa-tk-flow.jpg'
---

<section
  data-about
  class="bg-light-blue text-steel-blue py-24 md:py-32 lg:py-40 px-6 sm:px-8"
>
  <div class="mx-auto max-w-3xl text-left">
    <!-- Główny tekst -->
    <TextReveal
      class="text-xl sm:text-2xl lg:text-3xl font-sans font-medium leading-[1.75] sm:leading-[1.8] tracking-normal"
      color="bg-gradient-to-r from-white to-white text-white/50"
    >
      Nazywam się Tomasz Kulpa. Wspieram inwestorów i&nbsp;wykonawców w&nbsp;doborze oraz zaopatrzeniu w&nbsp;kluczowe komponenty do&nbsp;przesyłu wody i&nbsp;systemów wysokociśnieniowych.
      <br /><br />
      W&nbsp;TK Flow łączę zaplecze czołowych producentów z&nbsp;partnerskim doradztwem. Dbam o&nbsp;to, by&nbsp;instalacje pracowały bezawaryjnie, oszczędzając Twój czas i&nbsp;pieniądze.
    </TextReveal>

    <!-- Sygnatura autorska -->
    <div class="mt-12 sm:mt-16 pt-8 border-t border-white/10 flex items-center gap-5 sm:gap-6">
      <div class="relative shrink-0 w-16 h-16 sm:w-[4.5rem] sm:h-[4.5rem] rounded-full overflow-hidden ring-2 ring-white/20 shadow-lg bg-[#041A2F]">
        <img
          src={authorPhoto.src || '/tomasz-kulpa-tk-flow.jpg'}
          alt="Tomasz Kulpa"
          class="w-full h-full object-cover"
          loading="eager"
          decoding="async"
        />
      </div>

      <!-- Podpis -->
      <div class="flex flex-col justify-center">
        <span class="font-sans text-lg sm:text-xl font-semibold tracking-tight text-white leading-tight">
          Tomasz Kulpa
        </span>
        <span class="font-mono text-xs sm:text-sm tracking-widest uppercase text-white/70 mt-1">
          Założyciel & Doradca Techniczny
        </span>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  import { DOMLoaded } from '../ts/events'

  DOMLoaded(() => {
    gsap.registerPlugin(ScrollTrigger)

    const trigger = document.querySelector('[data-about]') as HTMLElement
    const target = trigger?.querySelector('p') as HTMLElement

    if (trigger && target) {
      gsap.to(target, {
        opacity: 0.15,
        scrollTrigger: {
          trigger: target,
          start: 'top 30%',
          end: () => `+=${window.innerHeight * 0.75}`,
          scrub: 1.2,
          invalidateOnRefresh: true,
        },
        ease: 'none',
      })
    }
  })
</script>