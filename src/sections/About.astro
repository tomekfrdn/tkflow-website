---
import TextReveal from '@/components/TextReveal.astro'
---

<section
  data-about
  class="bg-light-blue text-steel-blue py-40 lg:py-52 xl:py-60 px-8"
>
  <TextReveal
    class="text-3xl lg:text-4xl 2xl:text-5xl font-sans font-semibold max-w-[30ch] leading-normal lg:leading-normal 2xl:leading-normal mx-auto"
    color="bg-gradient-to-r from-white to-white text-white/50"
  >
      Nazywam się Tomasz Kulpa. Wspieram inwestorów i wykonawców w doborze oraz zaopatrzeniu w kluczowe komponenty do przesyłu wody i systemów wysokociśnieniowych.
    <br /><br />
      W TK Flow łączę zaplecze czołowych producentów z partnerskim doradztwem. Dbam o to, by instalacje pracowały bezawaryjnie, oszczędzając Twój czas i pieniądze.
  </TextReveal>
</section>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  import { DOMLoaded } from '../ts/events'

  DOMLoaded(() => {
    gsap.registerPlugin(ScrollTrigger)

    const trigger = document.querySelector('[data-about]') as HTMLElement
    const target = trigger?.querySelector('p') as HTMLElement

    if (trigger && target) {
      // Płynne, opóźnione wygaszanie tekstu z kontrolą tempa
      gsap.to(target, {
        opacity: 0.15, // Tekst nie znika do zera, zachowuje minimalną widoczność
        scrollTrigger: {
          trigger: trigger,
          start: 'top 35%', // Zaczyna blednąć dopiero, gdy środek sekcji minie środek ekranu
          end: 'bottom 15%',      // Kończy blednąć tuż przed wejściem kolejnej sekcji
          scrub: true,
        },
        ease: 'none',
      })
    }
  })
</script>