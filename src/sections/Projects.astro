---
import Card from '@/components/Card.astro'
import pompyImg from '@/images/pompy-do-myjni.webp'
import ruryImg from '@/images/rury-pe.webp'
---

<section
  data-projects
  class="bg-light-gray text-[#041A2F] flex flex-col items-center gap-12 lg:gap-16 py-28 lg:py-36 2xl:py-44 px-4 sm:px-8 overflow-hidden w-full"
>
  <div class="w-full max-w-4xl mx-auto flex flex-col items-center text-center">
    <h2
      data-projects-heading
      class="text-[#041A2F] text-3xl sm:text-4xl lg:text-5xl font-semibold tracking-tight leading-[1.15]"
    >
      Dedykowane strony produktowe
    </h2>
  </div>

  <div class="w-full max-w-5xl mx-auto flex justify-center">
    <ul
      data-projects-grid
      class="w-full m-0 p-0 list-none grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-10 lg:gap-12 justify-items-center"
    >
      <li data-project-card class="w-full flex justify-center">
        <Card
          image={pompyImg}
          title="sercemyjni.pl"
          description="Pompy wysokociśnieniowe do bezdotykowych myjni samochodowych."
          link="https://sercemyjni.pl"
          badge="Pompy do myjni samochodowych"
          accentColor="#be123c"
        />
      </li>
      <li data-project-card class="w-full flex justify-center">
        <Card
          image={ruryImg}
          title="rurape.pl"
          description="Rury polietylenowe do nawadniania w rolnictwie."
          link="https://rurape.pl"
          badge="Rury PE do nawadniania w rolnictwie"
          accentColor="#059669"
        />
      </li>
    </ul>
  </div>
</section>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  import { DOMLoaded } from '@/ts/events'

  DOMLoaded(() => {
    gsap.registerPlugin(ScrollTrigger)

    const projectsSection = document.querySelector('[data-projects]') as HTMLElement
    const heading = projectsSection?.querySelector('[data-projects-heading]') as HTMLElement
    const cards = projectsSection?.querySelectorAll('[data-project-card]')

    if (projectsSection && cards.length) {
      if (heading) {
        gsap.from(heading, {
          scrollTrigger: {
            trigger: heading,
            start: 'top 85%',
            toggleActions: 'play none none reverse',
          },
          y: 20,
          opacity: 0,
          duration: 0.8,
          ease: 'power2.out',
        })
      }

      gsap.from(cards, {
        scrollTrigger: {
          trigger: '[data-projects-grid]',
          start: 'top 80%',
          toggleActions: 'play none none reverse',
        },
        y: 45,
        opacity: 0,
        duration: 0.9,
        stagger: 0.18,
        ease: 'power3.out',
      })
    }
  })
</script>