---
// Projects.astro
---

<section
  id="projects"
  data-projects
  class="relative bg-[#0E1217] text-white py-28 md:py-36 px-6 md:px-12 border-b border-white/10 overflow-hidden"
>
  <div class="max-w-7xl mx-auto">
    <!-- Nagłówek sekcji -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 border-b border-white/10 pb-8 gap-6">
      <div>
        <div class="flex items-center gap-3 font-mono text-[10px] md:text-xs tracking-[0.25em] uppercase text-[#FF5500] mb-3">
          <span class="w-1.5 h-1.5 bg-[#FF5500]"></span>
          <span>03 // SPECYFIKACJA LINII PRODUKTOWYCH</span>
        </div>
        <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold uppercase tracking-tight text-white">
          Dedykowane Strony Produktowe
        </h2>
      </div>
      <p class="font-mono text-xs text-[#9AA4B2] max-w-sm tracking-wide">
        Wybierz dedykowany portal z pełnym katalogiem technicznym, kartami charakterystyki oraz formularzem wyceny.
      </p>
    </div>

    <!-- Prezentacja techniczna kart -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      
      <!-- sercemyjni.pl Card -->
      <div class="p-8 sm:p-12 rounded-2xl bg-[#12161D] border border-white/10 hover:border-[#FF5500]/60 transition-all duration-300 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-6 font-mono text-xs text-[#9AA4B2]">
            <span class="px-3 py-1 rounded bg-white/5 border border-white/10 text-white font-semibold">
              01 // HIGH PRESSURE
            </span>
            <span class="text-[#FF5500]">sercemyjni.pl</span>
          </div>

          <h3 class="font-display text-3xl sm:text-4xl font-extrabold uppercase text-white mb-4">
            sercemyjni.pl
          </h3>
          <p class="font-sans text-[#9AA4B2] text-sm sm:text-base leading-relaxed mb-8">
            Pompy wysokociśnieniowe do bezdotykowych myjni samochodowych. Zaawansowane korpusy, nurniki ceramiczne oraz uszczelnienia odporne na agresywne środki myjące i skoki ciśnień.
          </p>

          <ul class="font-mono text-xs text-white/70 space-y-2.5 mb-8 border-y border-white/5 py-6">
            <li class="flex justify-between">
              <span class="text-white/40">Zastosowanie:</span>
              <span>Myjnie bezdotykowe i przemysłowe</span>
            </li>
            <li class="flex justify-between">
              <span class="text-white/40">Główne medium:</span>
              <span>Woda uzdatniona / Chemia myjąca</span>
            </li>
            <li class="flex justify-between">
              <span class="text-white/40">Tryb pracy:</span>
              <span>Ciągły (Heavy Duty 24/7)</span>
            </li>
          </ul>
        </div>

        <a
          href="https://sercemyjni.pl"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 w-full py-4 rounded-xl bg-[#FF5500] hover:bg-[#FF6A1A] text-black font-mono text-xs font-bold uppercase tracking-widest transition-colors"
        >
          <span>Otwórz serwis sercemyjni.pl</span>
          <span>&rarr;</span>
        </a>
      </div>

      <!-- rurape.pl Card -->
      <div class="p-8 sm:p-12 rounded-2xl bg-[#12161D] border border-white/10 hover:border-emerald-500/60 transition-all duration-300 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-6 font-mono text-xs text-[#9AA4B2]">
            <span class="px-3 py-1 rounded bg-white/5 border border-white/10 text-white font-semibold">
              02 // AGRO INFRA
            </span>
            <span class="text-emerald-400">rurape.pl</span>
          </div>

          <h3 class="font-display text-3xl sm:text-4xl font-extrabold uppercase text-white mb-4">
            rurape.pl
          </h3>
          <p class="font-sans text-[#9AA4B2] text-sm sm:text-base leading-relaxed mb-8">
            Rury polietylenowe do nawadniania w rolnictwie. Kompletne magistrale przesyłowe o wysokiej odporności na pękanie naprężeniowe, promieniowanie UV oraz zjawisko uderzenia hydraulicznego.
          </p>

          <ul class="font-mono text-xs text-white/70 space-y-2.5 mb-8 border-y border-white/5 py-6">
            <li class="flex justify-between">
              <span class="text-white/40">Zastosowanie:</span>
              <span>Systemy irygacji upraw polowych i szklarni</span>
            </li>
            <li class="flex justify-between">
              <span class="text-white/40">Materiał bazowy:</span>
              <span>Polietylen PE100 / PE100-RC</span>
            </li>
            <li class="flex justify-between">
              <span class="text-white/40">Montaż:</span>
              <span>Zgrzewanie doczołowe / elektrooporowe / skręcane</span>
            </li>
          </ul>
        </div>

        <a
          href="https://rurape.pl"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 w-full py-4 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-black font-mono text-xs font-bold uppercase tracking-widest transition-colors"
        >
          <span>Otwórz serwis rurape.pl</span>
          <span>&rarr;</span>
        </a>
      </div>

    </div>
  </div>
</section>