---
// Projects.astro — The Technical Specification Matrix
---

<section class="relative w-full py-24 sm:py-32 bg-white border-b border-nv-border max-w-[1600px] mx-auto px-6 md:px-12">
  <div class="mb-16">
    <span class="block font-sans text-[10px] uppercase tracking-widest text-nv-muted font-bold mb-4">
      Specyfikacja Architektury
    </span>
    <h2 class="font-display font-extrabold text-3xl sm:text-5xl uppercase tracking-tighter text-nv-black">
      Parametryzacja Systemów
    </h2>
  </div>

  <div class="w-full overflow-x-auto">
    <table class="w-full text-left font-sans text-sm border-collapse min-w-[800px]">
      <thead>
        <tr class="text-nv-black text-xs uppercase tracking-widest bg-nv-gray">
          <th class="py-5 px-6 border border-nv-border font-bold w-1/3">Kryterium Techniczne</th>
          <th class="py-5 px-6 border border-nv-border font-bold w-1/3 text-[#059669]">Strumień Agro (rurape.pl)</th>
          <th class="py-5 px-6 border border-nv-border font-bold w-1/3 text-[#DC2626]">Siła Kinetyczna (sercemyjni.pl)</th>
        </tr>
      </thead>
      <tbody class="text-nv-black font-medium">
        <tr class="hover:bg-nv-gray/50 transition-colors">
          <td class="py-6 px-6 border border-nv-border">Główny Komponent</td>
          <td class="py-6 px-6 border border-nv-border text-nv-muted">Rury polietylenowe wysokiej gęstości</td>
          <td class="py-6 px-6 border border-nv-border text-nv-muted">Przemysłowe pompy nurnikowe</td>
        </tr>
        <tr class="hover:bg-nv-gray/50 transition-colors">
          <td class="py-6 px-6 border border-nv-border">Charakterystyka Pracy</td>
          <td class="py-6 px-6 border border-nv-border text-nv-muted">Woda czysta / magistrale i irygacja podziemna</td>
          <td class="py-6 px-6 border border-nv-border text-nv-muted">Ekstremalne obciążenie 200+ Bar / Agresywna chemia</td>
        </tr>
        <tr class="hover:bg-nv-gray/50 transition-colors">
          <td class="py-6 px-6 border border-nv-border">Zastosowane Materiały</td>
          <td class="py-6 px-6 border border-nv-border text-nv-muted">Polietylen PE100, PE100-RC (Odporność na pęknięcia)</td>
          <td class="py-6 px-6 border border-nv-border text-nv-muted">Mosiądz kuty, stal nierdzewna, pełna ceramika</td>
        </tr>
      </tbody>
    </table>
  </div>
</section>