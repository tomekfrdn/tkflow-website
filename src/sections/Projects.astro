---
// Projects.astro — The Massive Bifurcation Rows
---

<section id="platformy" class="w-full bg-white flex flex-col">
  
  <!-- BRAMA 01: AGRO -->
  <a 
    href="https://rurape.pl" 
    target="_blank" 
    rel="noopener noreferrer"
    class="group block w-full border-t-2 border-kh-black px-6 md:px-12 py-16 md:py-24 hover:bg-kh-agro hover:text-white kh-transition"
  >
    <div class="max-w-[1800px] mx-auto">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-8 mb-8 md:mb-16">
        <span class="font-bold text-sm md:text-lg uppercase tracking-widest opacity-60">01 &mdash; Nawadnianie Rolnicze</span>
        <div class="text-right">
          <span class="block font-bold text-xl md:text-3xl tracking-tighter">Rury PE100 / PE100-RC</span>
          <span class="block text-sm md:text-lg opacity-60 mt-2">DN 16 – 110 mm</span>
        </div>
      </div>
      
      <div class="flex items-center justify-between">
        <h2 class="font-extrabold text-[10vw] md:text-[8vw] leading-none tracking-tighter uppercase">
          RURAPE.PL
        </h2>
        <!-- Potężna strzałka -->
        <svg class="w-[8vw] h-[8vw] md:w-[6vw] md:h-[6vw] transform group-hover:rotate-45 kh-transition" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" />
        </svg>
      </div>
    </div>
  </a>

  <!-- BRAMA 02: MYJNIE -->
  <a 
    href="https://sercemyjni.pl" 
    target="_blank" 
    rel="noopener noreferrer"
    class="group block w-full border-t-2 border-kh-black px-6 md:px-12 py-16 md:py-24 hover:bg-kh-wash hover:text-white kh-transition"
  >
    <div class="max-w-[1800px] mx-auto">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-8 mb-8 md:mb-16">
        <span class="font-bold text-sm md:text-lg uppercase tracking-widest opacity-60">02 &mdash; Wysokie Ciśnienie 200 Bar</span>
        <div class="text-right">
          <span class="block font-bold text-xl md:text-3xl tracking-tighter">Pompy Nurnikowe Udor</span>
          <span class="block text-sm md:text-lg opacity-60 mt-2">Pełna ceramika &middot; Praca 24/7</span>
        </div>
      </div>
      
      <div class="flex items-center justify-between">
        <h2 class="font-extrabold text-[10vw] md:text-[8vw] leading-none tracking-tighter uppercase">
          SERCEMYJNI.PL
        </h2>
        <!-- Potężna strzałka -->
        <svg class="w-[8vw] h-[8vw] md:w-[6vw] md:h-[6vw] transform group-hover:rotate-45 kh-transition" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" />
        </svg>
      </div>
    </div>
  </a>

</section>