---
import Card from '@/components/Card.astro'
import projectOne from '@/images/project-1.png'
import projectTwo from '@/images/project-2.png'
---

<section
  data-projects
  class="bg-light-gray text-steel-blue flex flex-col gap-12 lg:gap-16 py-28 lg:py-36 2xl:py-44 px-6 sm:px-8 overflow-hidden"
>
  <h2
    data-projects-heading
    class="w-full max-w-4xl mx-auto text-dark-blue text-3xl lg:text-4xl 2xl:text-5xl text-center font-semibold"
  >
    Marki specjalistyczne
  </h2>

  <div class="w-full max-w-5xl mx-auto">
    <ul
      data-projects-grid
      class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 lg:gap-16 items-stretch"
    >
      <li data-project-card class="w-full flex justify-center">
        <div class="w-full max-w-md">
          <Card
            image={projectOne}
            title="sercemyjni.pl"
            description="Pompy wysokociśnieniowe do myjni samochodowych."
            link="https://sercemyjni.pl"
          />
        </div>
      </li>
      <li data-project-card class="w-full flex justify-center">
        <div class="w-full max-w-md">
          <Card
            image={projectTwo}
            title="rurape.pl"
            description="Rury PE do nawadniania i przesyłu wody w rolnictwie."
            link="https://rurape.pl"
          />
        </div>
      </li>
    </ul>
  </div>
</section>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  import { DOMLoaded } from '@/ts/events'

  DOMLoaded(() => {
    gsap.registerPlugin(ScrollTrigger)

    const projectsSection = document.querySelector('[data-projects]') as HTMLElement
    const heading = projectsSection?.querySelector('[data-projects-heading]') as HTMLElement
    const cards = projectsSection?.querySelectorAll('[data-project-card]')

    if (projectsSection && cards.length) {
      if (heading) {
        gsap.from(heading, {
          scrollTrigger: {
            trigger: heading,
            start: 'top 85%',
            toggleActions: 'play none none reverse',
          },
          y: 20,
          opacity: 0,
          duration: 0.8,
          ease: 'power2.out',
        })
      }

      gsap.from(cards, {
        scrollTrigger: {
          trigger: '[data-projects-grid]',
          start: 'top 80%',
          toggleActions: 'play none none reverse',
        },
        y: 45,
        opacity: 0,
        duration: 0.9,
        stagger: 0.18,
        ease: 'power3.out',
      })
    }
  })
</script>