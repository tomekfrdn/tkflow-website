---
// Projects.astro — The Technical Specification Matrix
---

<section class="w-full py-24 border-b border-tk-border max-w-[1600px] mx-auto bg-white">
  <div class="px-6 md:px-12 mb-16">
    <span class="block font-mono text-xs uppercase tracking-[0.2em] text-tk-muted font-bold mb-4">
      Specyfikacja Systemowa
    </span>
    <h2 class="font-extrabold text-3xl sm:text-4xl uppercase tracking-tighter text-tk-black">
      Parametryzacja Ofert
    </h2>
  </div>

  <div class="w-full overflow-x-auto">
    <table class="w-full text-left font-mono text-sm border-collapse min-w-[800px]">
      <thead>
        <tr class="text-tk-muted text-[10px] uppercase tracking-widest bg-[#F9FAFB]">
          <th class="py-6 px-6 md:px-12 border-y border-tk-border w-1/3 font-bold">Kryterium Techniczne</th>
          <th class="py-6 px-6 md:px-12 border-y border-l border-tk-border w-1/3 font-bold text-tk-agro">Strumień Agro (rurape.pl)</th>
          <th class="py-6 px-6 md:px-12 border-y border-l border-tk-border w-1/3 font-bold text-tk-wash">Siła Kinetyczna (sercemyjni.pl)</th>
        </tr>
      </thead>
      <tbody class="text-tk-black">
        <tr class="hover:bg-[#F9FAFB] transition-colors">
          <td class="py-6 px-6 md:px-12 border-b border-tk-border font-bold">Główny Komponent</td>
          <td class="py-6 px-6 md:px-12 border-b border-l border-tk-border">Rury polietylenowe wysokiej gęstości</td>
          <td class="py-6 px-6 md:px-12 border-b border-l border-tk-border">Przemysłowe pompy nurnikowe</td>
        </tr>
        <tr class="hover:bg-[#F9FAFB] transition-colors">
          <td class="py-6 px-6 md:px-12 border-b border-tk-border font-bold">Medium i Ciśnienie</td>
          <td class="py-6 px-6 md:px-12 border-b border-l border-tk-border">Woda czysta, irygacja / stałe, niskie obciążenie</td>
          <td class="py-6 px-6 md:px-12 border-b border-l border-tk-border">Woda + agresywna chemia / ekstremalne 200+ Bar</td>
        </tr>
        <tr class="hover:bg-[#F9FAFB] transition-colors">
          <td class="py-6 px-6 md:px-12 border-b border-tk-border font-bold">Użyte Materiały</td>
          <td class="py-6 px-6 md:px-12 border-b border-l border-tk-border">PE100, PE100-RC (Odporność na pęknięcia)</td>
          <td class="py-6 px-6 md:px-12 border-b border-l border-tk-border">Mosiądz kuty, stal nierdzewna, pełna ceramika</td>
        </tr>
        <tr class="hover:bg-[#F9FAFB] transition-colors">
          <td class="py-6 px-6 md:px-12 border-b border-tk-border font-bold">Certyfikacja / Marka</td>
          <td class="py-6 px-6 md:px-12 border-b border-l border-tk-border">Atesty higieniczne, normy budowlane UE</td>
          <td class="py-6 px-6 md:px-12 border-b border-l border-tk-border">Fabryka UDOR, Made in Italy (Oryginał)</td>
        </tr>
      </tbody>
    </table>
  </div>
</section>