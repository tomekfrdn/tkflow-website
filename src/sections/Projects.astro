---
// Projects.astro — The Technical Specification Matrix
---

<section class="w-full py-24 sm:py-32 bg-white max-w-[1600px] mx-auto px-6 md:px-12 border-b-2 border-kh-black">
  <div class="mb-16">
    <span class="block font-mono text-[10px] uppercase tracking-widest text-kh-muted font-bold mb-4">
      Specyfikacja Systemowa
    </span>
    <h2 class="font-display font-extrabold text-3xl sm:text-5xl uppercase tracking-tight text-kh-black">
      Parametryzacja Platform
    </h2>
  </div>

  <div class="w-full overflow-x-auto">
    <table class="w-full text-left font-mono text-sm border-collapse min-w-[800px]">
      <thead>
        <tr class="text-kh-black text-xs uppercase tracking-widest bg-kh-gray">
          <th class="py-5 px-6 border border-kh-border font-bold w-1/3">Kryterium Techniczne</th>
          <th class="py-5 px-6 border border-kh-border font-bold w-1/3 text-[#022C22]">Strumień Agro (rurape.pl)</th>
          <th class="py-5 px-6 border border-kh-border font-bold w-1/3 text-[#4C0519]">Siła Kinetyczna (sercemyjni.pl)</th>
        </tr>
      </thead>
      <tbody class="text-kh-black font-medium">
        <tr class="hover:bg-kh-gray/50 transition-colors">
          <td class="py-6 px-6 border border-kh-border">Główny Komponent</td>
          <td class="py-6 px-6 border border-kh-border text-kh-muted">Rury polietylenowe wysokiej gęstości</td>
          <td class="py-6 px-6 border border-kh-border text-kh-muted">Przemysłowe pompy nurnikowe</td>
        </tr>
        <tr class="hover:bg-kh-gray/50 transition-colors">
          <td class="py-6 px-6 border border-kh-border">Charakterystyka Pracy</td>
          <td class="py-6 px-6 border border-kh-border text-kh-muted">Woda czysta / magistrale i irygacja podziemna</td>
          <td class="py-6 px-6 border border-kh-border text-kh-muted">Ekstremalne obciążenie 200+ Bar / Agresywna chemia</td>
        </tr>
        <tr class="hover:bg-kh-gray/50 transition-colors">
          <td class="py-6 px-6 border border-kh-border">Zastosowane Materiały</td>
          <td class="py-6 px-6 border border-kh-border text-kh-muted">Polietylen PE100, PE100-RC (Odporność na pęknięcia)</td>
          <td class="py-6 px-6 border border-kh-border text-kh-muted">Mosiądz kuty, stal nierdzewna, pełna ceramika</td>
        </tr>
      </tbody>
    </table>
  </div>
</section>