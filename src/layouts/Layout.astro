---
import Header from '@/components/Header.astro'

interface Props {
  title: string
}

const { title } = Astro.props
---

<!doctype html>
<html lang="pl" class="scroll-smooth bg-[#F4F7FA] text-[#0A1A2F]">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="TK Flow Tomasz Kulpa — Centrala dystrybucji i doradztwa technicznego w przesyle wody: certyfikowane rury PE do nawadniania oraz przemysłowe pompy wysokociśnieniowe do myjni."
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon-tk-flow.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Google Fonts: Plus Jakarta Sans, Syne, JetBrains Mono -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;600;700&family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&family=Syne:wght@700;800&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;600;700&family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&family=Syne:wght@700;800&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;600;700&family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&family=Syne:wght@700;800&display=swap"
      />
    </noscript>
  </head>
  <body class="bg-[#F4F7FA] font-sans antialiased text-[#0A1A2F] selection:bg-[#0098E0] selection:text-white overflow-x-hidden">
    <Header />
    <slot />
  </body>
</html>

<style is:global>
  ::selection {
    background-color: #0098e0;
    color: #ffffff;
  }

  body {
    background-color: #f4f7fa;
    color: #0a1a2f;
  }

  ::-webkit-scrollbar {
    width: 8px;
  }
  ::-webkit-scrollbar-track {
    background: #e9eef4;
  }
  ::-webkit-scrollbar-thumb {
    background: #94a3b8;
    border-radius: 4px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: #0098e0;
  }
</style>