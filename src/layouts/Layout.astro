---
import Header from '@/components/Header.astro'

interface Props {
  title: string
}

const { title } = Astro.props
---

<!doctype html>
<html lang="pl" class="scroll-smooth bg-white text-[#0A1118]">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="TK Flow Tomasz Kulpa — Inżynieria przesyłu wody. Dystrybucja rur PE do nawadniania oraz pomp wysokociśnieniowych Udor."
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon-tk-flow.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Plus Jakarta Sans - perfekcyjna czytelność, używana przez topowe startupy i holdingi -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&display=swap"
      media="print"
      onload="this.media='all'"
    />
  </head>
  <body class="bg-white font-sans antialiased text-[#0A1118] selection:bg-[#0A1118] selection:text-white overflow-x-hidden">
    <Header />
    <slot />
  </body>
</html>

<style is:global>
  ::selection {
    background-color: #0a1118;
    color: #ffffff;
  }
  body {
    font-family: 'Plus Jakarta Sans', sans-serif;
  }
  ::-webkit-scrollbar {
    width: 6px;
  }
  ::-webkit-scrollbar-track {
    background: #f4f5f7;
  }
  ::-webkit-scrollbar-thumb {
    background: #0a1118;
  }
</style>