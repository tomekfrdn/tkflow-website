---
import Header from '@/components/Header.astro'

interface Props {
  title: string
}

const { title } = Astro.props
---

<!doctype html>
<html lang="pl" class="scroll-smooth bg-[#0B0D10] text-[#E5E9F0]">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="TK Flow - Architektura systemów przepływu cieczy. Infrastruktura nawadniania agro i pompy wysokociśnieniowe." />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon-tk-flow.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Preconnect pod Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Typografia Awwwards: Syne (display brutalism), Plus Jakarta Sans (body), JetBrains Mono (SCADA telemetria) -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&family=Syne:wght@700;800&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&family=Syne:wght@700;800&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&family=Syne:wght@700;800&display=swap"
      />
    </noscript>
  </head>
  <body class="bg-[#0B0D10] font-sans antialiased selection:bg-[#FF5500] selection:text-black overflow-x-hidden">
    <Header />
    <slot />
  </body>
</html>

<style is:global>
  ::selection {
    background-color: #ff5500;
    color: #000;
  }
  
  body {
    background-color: #0b0d10;
    color: #e5e9f0;
  }

  /* Wygląd scrollbara w stylu CAD */
  ::-webkit-scrollbar {
    width: 6px;
  }
  ::-webkit-scrollbar-track {
    background: #0b0d10;
  }
  ::-webkit-scrollbar-thumb {
    background: #1f242d;
    border-radius: 3px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: #ff5500;
  }
</style>