---
import Header from '@/components/Header.astro'

interface Props {
  title: string
}

const { title } = Astro.props
---

<!doctype html>
<html lang="pl" class="scroll-smooth bg-[#0D0F12] text-[#F3F4F6]">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="TK Flow Tomasz Kulpa — Zaawansowana infrastruktura przesyłu wody dla rolnictwa oraz systemy pomp wysokociśnieniowych."
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon-tk-flow.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Czysta, geometryczna typografia w stylu Northvolt -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&display=swap"
    />
  </head>
  <body class="bg-[#0D0F12] font-sans antialiased text-[#F3F4F6] selection:bg-white selection:text-black overflow-x-hidden">
    <Header />
    <slot />
  </body>
</html>

<style is:global>
  ::selection {
    background-color: #ffffff;
    color: #000000;
  }

  body {
    background-color: #0d0f12;
    color: #f3f4f6;
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
  }

  ::-webkit-scrollbar {
    width: 6px;
  }
  ::-webkit-scrollbar-track {
    background: #0d0f12;
  }
  ::-webkit-scrollbar-thumb {
    background: #252930;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: #3f4550;
  }
</style>