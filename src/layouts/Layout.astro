---
import Header from '@/components/Header.astro'

interface Props {
  title: string
}

const { title } = Astro.props
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="TK Flow - Zaawansowane technologie przesyłu cieczy, instalacje pompowe i armatura przemysłowa." />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon-tk-flow.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Zoptymalizowany preconnect do Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Fonty: Syne (H1 display), Plus Jakarta Sans (body), JetBrains Mono (detale inżynieryjne) -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&family=Syne:wght@700;800&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&family=Syne:wght@700;800&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&family=Syne:wght@700;800&display=swap"
      />
    </noscript>
  </head>
  <body class="bg-brand-surface font-sans text-white antialiased selection:bg-brand-cyan selection:text-brand-surface">
    <Header />
    <slot />
  </body>
</html>

<style is:global>
  html {
    @apply scroll-smooth;
  }

  body {
    background-color: #030c15;
    font-family: 'Plus Jakarta Sans', sans-serif;
  }

  p {
    @apply text-pretty;
  }
</style>