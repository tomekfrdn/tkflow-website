---
import Header from '@/components/Header.astro'

interface Props {
  title: string
}

const { title } = Astro.props
---

<!doctype html>
<html lang="pl" class="scroll-smooth bg-white text-[#0A1118]">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="TK Flow Tomasz Kulpa — Centrala dystrybucji i inżynierii doboru. Certyfikowane rury PE do nawadniania oraz przemysłowe pompy wysokociśnieniowe Udor."
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon-tk-flow.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Plus Jakarta Sans (Nagłówki) & JetBrains Mono (Parametry) -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Plus+Jakarta+Sans:ital,wght@0,400..800;1,400..800&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Plus+Jakarta+Sans:ital,wght@0,400..800;1,400..800&display=swap"
      media="print"
      onload="this.media='all'"
    />
  </head>
  <body class="bg-white font-sans antialiased text-[#0A1118] selection:bg-[#0A1118] selection:text-white overflow-x-hidden">
    <!-- Globalna siatka tła (Subtelne linie budujące strukturę rurociągu) -->
    <div class="fixed inset-0 pointer-events-none z-[-1] flex justify-center">
      <div class="w-full max-w-[1600px] h-full border-x border-[#E5E7EB]/60 relative">
        <div class="absolute inset-y-0 left-1/2 w-[1px] bg-[#E5E7EB]/60 hidden md:block"></div>
      </div>
    </div>

    <Header />
    <slot />
  </body>
</html>

<style is:global>
  ::selection {
    background-color: #0a1118;
    color: #ffffff;
  }
  body {
    font-family: 'Plus Jakarta Sans', sans-serif;
  }
  
  /* Animacja pulsującej wody (ciśnienia) w rurze/siatce */
  @keyframes flow-y {
    0% { transform: translateY(-100%); opacity: 0; }
    20% { opacity: 1; }
    80% { opacity: 1; }
    100% { transform: translateY(100vh); opacity: 0; }
  }
  .animate-flow {
    animation: flow-y 4s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  ::-webkit-scrollbar {
    width: 6px;
  }
  ::-webkit-scrollbar-track {
    background: #ffffff;
    border-left: 1px solid #E5E7EB;
  }
  ::-webkit-scrollbar-thumb {
    background: #0a1118;
  }
</style>