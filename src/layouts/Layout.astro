---
import Header from '@/components/Header.astro'

interface Props {
  title: string
}

const { title } = Astro.props
---

<!doctype html>
<html lang="pl" class="scroll-smooth bg-[#EFECE5] text-[#121416]">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="TK Flow — Technologie przesyłu cieczy. Centrala dystrybucji i doradztwa technicznego." />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon-tk-flow.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-[#EFECE5] font-sans antialiased text-[#121416] selection:bg-[#121416] selection:text-white overflow-x-hidden flex flex-col min-h-screen">
    <div class="fixed top-0 bottom-0 left-6 md:left-12 w-[1px] bg-[#CCC9BC] z-[-1] pointer-events-none"></div>
    <div class="fixed top-0 bottom-0 right-6 md:right-12 w-[1px] bg-[#CCC9BC] z-[-1] pointer-events-none"></div>

    <Header />
    <slot />
  </body>
</html>

<style is:global>
  ::selection {
    background-color: #121416;
    color: #ffffff;
  }
  body {
    font-family: 'Inter', sans-serif;
  }
  h1, h2, h3, .font-display {
    font-family: 'Plus Jakarta Sans', sans-serif;
  }
  .kh-transition {
    transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  ::-webkit-scrollbar {
    width: 6px;
  }
  ::-webkit-scrollbar-track {
    background: #efece5;
    border-left: 1px solid #ccc9bc;
  }
  ::-webkit-scrollbar-thumb {
    background: #121416;
  }
</style>