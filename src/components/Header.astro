<!-- Główny dokujący pasek nawigacyjny -->
<header
  data-navbar
  class="fixed top-0 inset-x-0 z-40 h-14 sm:h-16 pointer-events-none flex items-center justify-between px-4 sm:px-8 border-b border-transparent transition-colors duration-300"
>
  <!-- Prawy róg: Button telefonu (idealnie wyśrodkowany w pionie dzięki items-center w header) -->
  <div class="pointer-events-auto ml-auto z-30">
    <a
      data-phone-btn
      href="tel:+48000000000"
      style="background-color: #041A2F;"
      class="group inline-flex items-center gap-1.5 sm:gap-2 rounded-2xl px-3 py-1.5 sm:px-4 sm:py-2 text-white transition-transform duration-200 hover:scale-[1.02] active:scale-95 shadow-md border border-white/10"
      aria-label="Zadzwoń do TK Flow"
    >
      <span class="text-[10px] sm:text-xs font-semibold uppercase tracking-wider text-white/80 group-hover:text-white transition-colors">
        Zadzwoń
      </span>
      <span class="relative flex h-1.5 w-1.5 sm:h-2 sm:w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-1.5 w-1.5 sm:h-2 sm:w-2 bg-emerald-400"></span>
      </span>
      <span class="font-mono text-xs sm:text-sm font-medium tracking-tight text-white">
        +48 000 000 000
      </span>
    </a>
  </div>
</header>

<!-- Kinetyczny element TK Flow: stała wysokość h-14/h-16 i flex items-center dla idealnego wyśrodkowania w pionie -->
<div
  data-brand-wrap
  class="fixed top-0 inset-x-0 h-14 sm:h-16 px-4 sm:px-8 z-50 pointer-events-none select-none flex items-center justify-center"
>
  <div data-brand-inner class="flex flex-col items-center justify-center text-center">
    <span
      data-brand-title
      class="inline-block font-semibold tracking-tight whitespace-nowrap text-[clamp(2.25rem,7vw,5rem)] leading-none"
      style="color: #041A2F;"
    >
      TK Flow
    </span>
    <span
      data-brand-subtitle
      class="block text-[clamp(0.75rem,1.2vw,0.875rem)] font-light tracking-[0.25em] sm:tracking-[0.3em] text-white/90 uppercase mt-3 sm:mt-4 max-w-md"
    >
      technologie przesyłu cieczy
    </span>
  </div>
</div>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  import { DOMLoaded } from '@/ts/events'

  DOMLoaded(() => {
    gsap.registerPlugin(ScrollTrigger)

    const hero = document.querySelector('[data-hero]') as HTMLElement
    const about = document.querySelector('[data-about]') as HTMLElement
    const navbar = document.querySelector('[data-navbar]') as HTMLElement
    const brandWrap = document.querySelector('[data-brand-wrap]') as HTMLElement
    const brandInner = document.querySelector('[data-brand-inner]') as HTMLElement
    const brandTitle = document.querySelector('[data-brand-title]') as HTMLElement
    const brandSubtitle = document.querySelector('[data-brand-subtitle]') as HTMLElement

    if (hero && brandWrap && brandTitle && navbar && brandInner) {
      // Ustawienie początkowej pozycji centralnej w widoku Hero
      gsap.set(brandInner, {
        y: () => window.innerHeight * 0.42,
      })

      const heroTl = gsap.timeline({
        scrollTrigger: {
          trigger: hero,
          start: 'top top',
          end: 'bottom top',
          scrub: true,
          invalidateOnRefresh: true,
        },
      })

      // Etap 1: Wygaszenie podtytułu
      if (brandSubtitle) {
        heroTl.to(brandSubtitle, {
          opacity: 0,
          y: -10,
          duration: 0.35,
          ease: 'power1.out',
        }, 0)
      }

      // Etap 1: Płynne podjechanie w osi pionowej do środka wysokości belki h-14/h-16
      heroTl.to(brandInner, {
        y: 0,
        duration: 0.7,
        ease: 'power1.inOut',
      }, 0)

      heroTl.to(brandTitle, {
        fontSize: '1.25rem',
        duration: 0.7,
        ease: 'power1.inOut',
      }, 0)

      // Etap 2: Przemieszczenie na lewą stronę dopiero po wygaszeniu podtytułu
      heroTl.to(brandWrap, {
        justifyContent: 'flex-start',
        duration: 0.3,
        ease: 'power2.out',
      }, 0.7)

      heroTl.to(brandInner, {
        alignItems: 'flex-start',
        textAlign: 'left',
        duration: 0.3,
        ease: 'power2.out',
      }, 0.7)

      // 2. Aktywacja tła paska #00a3e0 DOPIERO na wejściu sekcji About
      if (about) {
        ScrollTrigger.create({
          trigger: about,
          start: 'top 56px', // dokładnie gdy sekcja styka się ze spodem paska
          onEnter: () => {
            gsap.to(navbar, {
              backgroundColor: 'rgba(0, 163, 224, 0.95)',
              backdropFilter: 'blur(12px)',
              borderColor: 'rgba(255, 255, 255, 0.15)',
              duration: 0.25,
              ease: 'power1.out',
            })
          },
          onLeaveBack: () => {
            gsap.to(navbar, {
              backgroundColor: 'rgba(0, 163, 224, 0)',
              backdropFilter: 'blur(0px)',
              borderColor: 'rgba(255, 255, 255, 0)',
              duration: 0.25,
              ease: 'power1.out',
            })
          },
        })
      }
    }
  })
</script>