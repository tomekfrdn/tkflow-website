---
// Header.astro — Dyskretna tafla szkła z bezpośrednim telefonem do doradcy
---

<header
  data-navbar
  class="fixed top-0 inset-x-0 z-50 h-16 sm:h-20 flex items-center justify-between px-6 md:px-12 transition-all duration-300 pointer-events-none"
>
  <!-- Tło aktywowane po scrollowaniu -->
  <div
    data-navbar-bg
    class="absolute inset-0 bg-[#020B14]/85 backdrop-blur-md border-b border-white/10 opacity-0 transition-opacity duration-300 pointer-events-none shadow-lg"
  ></div>

  <!-- Lewy slot: Logo TK Flow -->
  <div class="relative z-10 flex items-center gap-3 pointer-events-auto">
    <a href="#" class="group flex items-center gap-3 outline-none">
      <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-[#005B99] to-[#00A3E0] flex items-center justify-center text-white font-extrabold text-sm shadow-md group-hover:scale-105 transition-transform">
        TK
      </div>
      <div class="flex flex-col">
        <span class="font-extrabold text-lg sm:text-xl tracking-tight text-white uppercase leading-none">
          TK Flow
        </span>
        <span class="font-mono text-[9px] text-[#8FAEC4] tracking-wider uppercase mt-1 font-semibold">
          Technologie Przesyłu Wody
        </span>
      </div>
    </a>
  </div>

  <!-- Środek: Dwa portale produktowe -->
  <nav class="hidden lg:flex items-center gap-6 relative z-10 font-mono text-xs tracking-wider uppercase pointer-events-auto">
    <a
      href="https://rurape.pl"
      target="_blank"
      rel="noopener noreferrer"
      class="group inline-flex items-center gap-2 py-1.5 px-3.5 rounded-full text-white/80 hover:text-white bg-white/5 hover:bg-emerald-500/20 border border-white/10 hover:border-emerald-400/40 transition-all font-medium"
    >
      <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
      <span>Nawadnianie: rurape.pl</span>
      <span class="text-[10px] text-white/40 group-hover:text-emerald-400 transition-colors">&nearr;</span>
    </a>

    <a
      href="https://sercemyjni.pl"
      target="_blank"
      rel="noopener noreferrer"
      class="group inline-flex items-center gap-2 py-1.5 px-3.5 rounded-full text-white/80 hover:text-white bg-white/5 hover:bg-rose-500/20 border border-white/10 hover:border-rose-400/40 transition-all font-medium"
    >
      <span class="w-2 h-2 rounded-full bg-rose-400"></span>
      <span>Pompy Myjni: sercemyjni.pl</span>
      <span class="text-[10px] text-white/40 group-hover:text-rose-400 transition-colors">&nearr;</span>
    </a>

    <a
      href="#about"
      class="text-[#8FAEC4] hover:text-white transition-colors py-1.5 px-2 font-medium"
    >
      Doradca
    </a>
  </nav>

  <!-- Prawy róg: Direct Contact -->
  <div class="relative z-10 flex items-center pointer-events-auto">
    <a
      href="tel:+48000000000"
      class="group inline-flex items-center gap-3 rounded-full px-4 py-2 bg-gradient-to-r from-[#005B99] to-[#00A3E0] hover:from-[#006BB3] hover:to-[#00B4F5] text-white shadow-lg transition-all duration-200 hover:scale-[1.02] border border-white/20"
      aria-label="Zadzwoń do Tomasza Kulpy"
    >
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-400"></span>
      </span>
      <div class="flex flex-col text-left">
        <span class="text-[9px] uppercase tracking-wider text-white/80 leading-none font-mono">
          Tomasz Kulpa &middot; Telefon
        </span>
        <span class="font-mono text-xs sm:text-sm font-bold tracking-tight text-white mt-0.5">
          +48 000 000 000
        </span>
      </div>
    </a>
  </div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const navbarBg = document.querySelector('[data-navbar-bg]') as HTMLElement

    const handleScroll = () => {
      const isScrolled = window.scrollY > 25
      if (navbarBg) navbarBg.style.opacity = isScrolled ? '1' : '0'
    }

    window.addEventListener('scroll', handleScroll, { passive: true })
    handleScroll()
  })
</script>