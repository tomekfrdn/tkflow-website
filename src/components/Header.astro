---
// Header.astro — Technical Command Bar
---

<header
  class="fixed top-0 inset-x-0 z-50 h-20 bg-white/95 backdrop-blur-md border-b border-tk-border flex items-center justify-between px-6 md:px-12 transition-all duration-300"
>
  <!-- Lewa strona: Identyfikator -->
  <div class="flex items-center gap-6">
    <a href="/" class="flex flex-col outline-none group">
      <span class="font-extrabold text-2xl tracking-tighter text-tk-black uppercase leading-none">
        TK FLOW
      </span>
      <span class="font-mono text-[9px] text-tk-muted tracking-widest uppercase mt-1 font-bold flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-tk-water animate-pulse"></span>
        Status: Przepływ Aktywny
      </span>
    </a>
  </div>

  <!-- Środek: Czyste odnośniki (tylko Desktop) -->
  <nav class="hidden lg:flex items-center gap-10 font-mono text-[11px] font-bold tracking-widest uppercase text-tk-muted">
    <a href="https://rurape.pl" target="_blank" rel="noopener noreferrer" class="hover:text-tk-black transition-colors">
      [01] Rurape.pl
    </a>
    <a href="https://sercemyjni.pl" target="_blank" rel="noopener noreferrer" class="hover:text-tk-black transition-colors">
      [02] Sercemyjni.pl
    </a>
    <a href="#inżynieria" class="hover:text-tk-black transition-colors">
      [03] Doradztwo
    </a>
  </nav>

  <!-- Prawa strona: B2B Direct Contact -->
  <div class="flex items-center border-l border-tk-border pl-6 h-full">
    <a
      href="tel:+48000000000"
      class="group flex flex-col text-right hover:opacity-70 transition-opacity"
    >
      <span class="text-[9px] uppercase tracking-widest text-tk-muted font-bold font-mono mb-0.5">
        Terminal Ofertowy
      </span>
      <span class="font-bold text-lg text-tk-black tracking-tight leading-none">
        +48 000 000 000
      </span>
    </a>
  </div>
</header>