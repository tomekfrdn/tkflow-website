<!-- Główny pasek nawigacyjny -->
<header
  data-navbar
  class="fixed top-0 inset-x-0 z-40 h-14 sm:h-16 flex items-center justify-between px-4 sm:px-8 border-b border-transparent pointer-events-none select-none"
>
  <!-- Niezależna warstwa tła -->
  <div
    data-navbar-bg
    class="absolute inset-0 bg-[#00a3e0]/95 backdrop-blur-md border-b border-white/15 opacity-0 pointer-events-none will-change-[opacity]"
  ></div>

  <!-- Lewy slot: napis TK Flow -->
  <div data-brand-anchor class="relative flex items-center z-30">
    <h1 data-brand-group class="relative flex flex-col items-start justify-center will-change-transform m-0 p-0 origin-left">
      <span
        data-brand-title
        class="inline-block font-semibold tracking-tight whitespace-nowrap leading-none text-xl sm:text-2xl"
        style="color: #041A2F;"
      >
        TK Flow
      </span>
      
      <span
        data-brand-subtitle
        class="absolute top-full left-0 block text-[11px] sm:text-xs font-light tracking-[0.25em] text-white/90 uppercase mt-2 whitespace-nowrap pointer-events-none origin-left"
      >
        technologie przesyłu cieczy
      </span>
    </h1>
  </div>

  <!-- Środek na desktopie -->
  <nav
    data-navbar-nav
    class="hidden md:flex absolute left-1/2 -translate-x-1/2 top-1/2 -translate-y-1/2 items-center gap-10 z-30 pointer-events-auto opacity-0"
  >
    <a
      href="#pompy-do-myjni"
      class="group relative py-1 text-xs uppercase tracking-[0.2em] font-medium text-white transition-opacity duration-200"
    >
      <span>Pompy do myjni</span>
      <span class="absolute bottom-0 left-0 w-0 h-px bg-white transition-all duration-300 ease-out group-hover:w-full"></span>
    </a>

    <a
      href="#rury-pe"
      class="group relative py-1 text-xs uppercase tracking-[0.2em] font-medium text-white transition-opacity duration-200"
    >
      <span>Rury PE do nawadniania</span>
      <span class="absolute bottom-0 left-0 w-0 h-px bg-white transition-all duration-300 ease-out group-hover:w-full"></span>
    </a>
  </nav>

  <!-- Prawy róg: Button telefonu -->
  <div class="pointer-events-auto ml-auto z-30 flex items-center">
    <a
      data-phone-btn
      href="tel:+48000000000"
      style="background-color: #041A2F;"
      class="group inline-flex items-center justify-center gap-1.5 sm:gap-2 rounded-2xl px-3 py-2 sm:px-4 sm:py-2.5 text-white transition-transform duration-200 hover:scale-[1.02] active:scale-95 shadow-md border border-white/10"
      aria-label="Zadzwoń do TK Flow"
    >
      <span class="text-[10px] sm:text-xs font-semibold uppercase tracking-wider text-white/80 group-hover:text-white transition-colors leading-none flex items-center">
        Zadzwoń
      </span>

      <span class="relative flex h-1.5 w-1.5 sm:h-2 sm:w-2 shrink-0 self-center">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-1.5 w-1.5 sm:h-2 sm:w-2 bg-emerald-400"></span>
      </span>

      <span class="font-mono text-xs sm:text-sm font-medium tracking-tight text-white leading-none flex items-center">
        +48 000 000 000
      </span>
    </a>
  </div>
</header>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  import { DOMLoaded } from '@/ts/events'

  DOMLoaded(() => {
    gsap.registerPlugin(ScrollTrigger)

    const hero = document.querySelector('[data-hero]') as HTMLElement
    const navbarBg = document.querySelector('[data-navbar-bg]') as HTMLElement
    const navbarNav = document.querySelector('[data-navbar-nav]') as HTMLElement
    const brandGroup = document.querySelector('[data-brand-group]') as HTMLElement
    const brandSubtitle = document.querySelector('[data-brand-subtitle]') as HTMLElement

    if (hero && navbarBg && brandGroup) {
      // Wyliczanie wektora powrotu do środka ekranu przy załadowaniu od scrollY = 0
      const getHeroVector = () => {
        const titleRect = brandGroup.getBoundingClientRect()
        const scaleFactor = Math.min(Math.max(window.innerWidth / 360, 2), 3.2)
        
        // Obliczamy pozycję względem okna z uwzględnieniem obecnego scrolla
        const currentBrandX = titleRect.left
        const currentBrandY = titleRect.top + window.scrollY

        const targetCenterX = (window.innerWidth / 2) - ((titleRect.width * scaleFactor) / 2)
        const targetCenterY = (window.innerHeight * 0.42)

        return {
          x: targetCenterX - currentBrandX,
          y: targetCenterY - currentBrandY,
          scale: scaleFactor,
        }
      }

      // Jeśli strona odświeżyła się już w sekcji About (scrollY > hero.offsetHeight):
      // Zostawiamy stan docelowy paska (mały, w lewym rogu) i pokazujemy tło
      if (window.scrollY >= hero.offsetHeight) {
        gsap.set(brandGroup, { x: 0, y: 0, scale: 1 })
        gsap.set(navbarBg, { opacity: 1 })
        if (navbarNav) gsap.set(navbarNav, { opacity: 1 })
        if (brandSubtitle) gsap.set(brandSubtitle, { opacity: 0 })
      }

      const heroTl = gsap.timeline({
        scrollTrigger: {
          trigger: hero,
          start: 'top top',
          end: 'bottom top',
          scrub: true,
          fastScrollEnd: true,
          preventOverlaps: 'heroNavbar',
          invalidateOnRefresh: true,
        },
      })

      // Animujemy z wyliczonego środka Hero do lewego górnego rogu
      heroTl.fromTo(
        brandGroup,
        {
          x: () => getHeroVector().x,
          y: () => getHeroVector().y,
          scale: () => getHeroVector().scale,
        },
        {
          x: 0,
          y: 0,
          scale: 1,
          duration: 0.8,
          ease: 'none',
        },
        0
      )

      if (brandSubtitle) {
        heroTl.fromTo(
          brandSubtitle,
          { opacity: 1, scale: 1 },
          { opacity: 0, scale: 0.8, duration: 0.3, ease: 'none' },
          0
        )
      }

      heroTl.to(
        navbarBg,
        { opacity: 1, duration: 0.15, ease: 'none' },
        0.85
      )

      if (navbarNav) {
        heroTl.to(
          navbarNav,
          { opacity: 1, duration: 0.15, ease: 'none' },
          0.85
        )
      }
    }
  })
</script>