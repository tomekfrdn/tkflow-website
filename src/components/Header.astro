<header
  data-header
  class="fixed inset-x-2 top-[calc(50%-10vh)] text-[10vw] leading-none z-20 pointer-events-none select-none"
>
  <h1 class="text-center font-semibold tracking-tight">
    <!-- Tytuł z klasą do animacji GSAP -->
    <span 
      data-title 
      class="inline-block whitespace-nowrap" 
      style="color: #041A2F;"
    >
      TK Flow
    </span>
    <!-- Podtytuł ze sztywną bielą -->
    <span 
      data-subtitle 
      class="block text-[0.28em] font-normal tracking-wider uppercase mt-2" 
      style="color: #ffffff;"
    >
      technologie przesyłu cieczy
    </span>
  </h1>
</header>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  import { DOMLoaded } from '@/ts/events'

  DOMLoaded(() => {
    gsap.registerPlugin(ScrollTrigger)
    
    const hero = document.querySelector('[data-hero]') as HTMLElement
    const header = document.querySelector('[data-header]') as HTMLElement
    const title = header?.querySelector('[data-title]') as HTMLElement
    const subtitle = header?.querySelector('[data-subtitle]') as HTMLElement

    if (hero && header) {
      // 1. Zmniejszanie nagłówka do górnej belki
      gsap.to(header, {
        scrollTrigger: {
          trigger: hero,
          start: 'top top',
          end: 'bottom 25%',
          scrub: true,
        },
        fontSize: '1.75rem',
        top: '1.25rem',
        ease: 'none',
      })

      // 2. Wygaszenie podtytułu podczas scrollowania
      if (subtitle) {
        gsap.to(subtitle, {
          scrollTrigger: {
            trigger: hero,
            start: 'top top',
            end: 'center top',
            scrub: true,
          },
          opacity: 0,
          y: -10,
          ease: 'none',
        })
      }

      // 3. Zmiana koloru TK Flow z granatu (#041A2F) na czystą biel (#FFFFFF),
      // gdy nagłówek opuszcza Hero i wjeżdża na ciemne tło kolejnej sekcji
      if (title) {
        gsap.to(title, {
          scrollTrigger: {
            trigger: hero,
            start: 'center top',
            end: 'bottom top',
            scrub: true,
          },
          color: '#ffffff',
          ease: 'none',
        })
      }
    }
  })
</script>