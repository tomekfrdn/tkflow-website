<header
  data-header
  class="fixed inset-x-2 top-[calc(50%-10vh)] text-[10vw] leading-none z-20 pointer-events-none select-none"
>
  <h1 class="text-center font-semibold tracking-tight">
    <!-- Klikalny tytuł po zadokowaniu na górze -->
    <a 
      href="#" 
      data-title 
      class="inline-block whitespace-nowrap text-[#041A2F] pointer-events-auto cursor-pointer"
    >
      TK Flow
    </a>
    <span 
      data-subtitle 
      class="block text-[0.28em] font-normal tracking-wider text-slate-300 uppercase mt-2 will-change-transform"
    >
      technologie przesyłu cieczy
    </span>
  </h1>
</header>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  import { DOMLoaded } from '@/ts/events'

  DOMLoaded(() => {
    gsap.registerPlugin(ScrollTrigger)
    
    const hero = document.querySelector('[data-hero]') as HTMLElement
    const header = document.querySelector('[data-header]') as HTMLElement
    const title = header?.querySelector('[data-title]') as HTMLElement
    const subtitle = header?.querySelector('[data-subtitle]') as HTMLElement

    if (hero && header) {
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: hero,
          start: 'top top',
          end: 'bottom 25%',
          scrub: 0.5, // Delikatne wygładzenie bez szarpnięć
        },
      })

      // 1. Płynne skalowanie i dokowanie nagłówka do góry
      tl.to(
        header,
        {
          fontSize: '1.75rem',
          top: '1.25rem',
          ease: 'power1.out',
        },
        0
      )

      // 2. Czyste wygaszenie podtytułu na początku scrolla
      if (subtitle) {
        tl.to(
          subtitle,
          {
            opacity: 0,
            y: -12,
            height: 0,
            marginTop: 0,
            ease: 'power1.out',
          },
          0
        )
      }

      // 3. Adaptacja koloru:
      // Gdy Twoje sekcje poniżej Hero wymagają innego koloru (np. bieli na sekcji Projects/About),
      // odkomentuj poniższy fragment i dopasuj kolor docelowy:
      /*
      if (title) {
        tl.to(
          title,
          {
            color: '#FFFFFF',
            ease: 'none',
          },
          0.3
        )
      }
      */
    }
  })
</script>