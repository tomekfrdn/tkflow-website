<!-- Główny pasek nawigacyjny: h-14 na mobile / h-16 na desktopie -->
<header
  data-navbar
  class="fixed top-0 inset-x-0 z-40 h-14 sm:h-16 flex items-center justify-between px-4 sm:px-8 pointer-events-none select-none overflow-hidden"
>
  <!-- Niezależna, akcelerowana sprzętowo warstwa tła (eliminuje mruganie warstw GPU) -->
  <div
    data-navbar-bg
    class="absolute inset-0 bg-[#00a3e0]/95 backdrop-blur-md border-b border-white/15 opacity-0 pointer-events-none will-change-[opacity]"
  ></div>

  <!-- Lewy slot: napis TK Flow wraz z podtytułem -->
  <div data-brand-anchor class="relative flex items-center z-30">
    <div data-brand-group class="relative flex flex-col items-start justify-center will-change-transform">
      <span
        data-brand-title
        class="inline-block font-semibold tracking-tight whitespace-nowrap leading-none origin-left"
        style="color: #041A2F;"
      >
        TK Flow
      </span>
      
      <!-- Podtytuł poza przepływem pionowym -->
      <span
        data-brand-subtitle
        class="absolute top-full left-1/2 -translate-x-1/2 block text-[clamp(0.75rem,1.2vw,0.875rem)] font-light tracking-[0.25em] sm:tracking-[0.3em] text-white/90 uppercase mt-3 whitespace-nowrap pointer-events-none"
      >
        technologie przesyłu cieczy
      </span>
    </div>
  </div>

  <!-- Prawy róg: Button telefonu -->
  <div class="pointer-events-auto ml-auto z-30 flex items-center">
    <a
      data-phone-btn
      href="tel:+48000000000"
      style="background-color: #041A2F;"
      class="group inline-flex items-center gap-1.5 sm:gap-2 rounded-2xl px-3 py-1.5 sm:px-4 sm:py-2 text-white transition-transform duration-200 hover:scale-[1.02] active:scale-95 shadow-md border border-white/10"
      aria-label="Zadzwoń do TK Flow"
    >
      <span class="text-[10px] sm:text-xs font-semibold uppercase tracking-wider text-white/80 group-hover:text-white transition-colors">
        Zadzwoń
      </span>
      <span class="relative flex h-1.5 w-1.5 sm:h-2 sm:w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-1.5 w-1.5 sm:h-2 sm:w-2 bg-emerald-400"></span>
      </span>
      <span class="font-mono text-xs sm:text-sm font-medium tracking-tight text-white">
        +48 000 000 000
      </span>
    </a>
  </div>
</header>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  import { DOMLoaded } from '@/ts/events'

  DOMLoaded(() => {
    gsap.registerPlugin(ScrollTrigger)

    const hero = document.querySelector('[data-hero]') as HTMLElement
    const navbarBg = document.querySelector('[data-navbar-bg]') as HTMLElement
    const brandGroup = document.querySelector('[data-brand-group]') as HTMLElement
    const brandTitle = document.querySelector('[data-brand-title]') as HTMLElement
    const brandSubtitle = document.querySelector('[data-brand-subtitle]') as HTMLElement

    if (hero && navbarBg && brandGroup && brandTitle) {
      const calculateOffsets = () => {
        const startFontSize = Math.min(Math.max(window.innerWidth * 0.07, 36), 80)
        gsap.set(brandTitle, { fontSize: `${startFontSize}px` })

        const rect = brandTitle.getBoundingClientRect()
        const targetX = (window.innerWidth / 2) - (rect.width / 2) - rect.left
        const targetY = (window.innerHeight * 0.42) - rect.top

        return { targetX, targetY }
      }

      let offsets = calculateOffsets()

      // Wyjściowa pozycja w Hero
      gsap.set(brandGroup, {
        x: offsets.targetX,
        y: offsets.targetY,
      })

      const heroTl = gsap.timeline({
        scrollTrigger: {
          trigger: hero,
          start: 'top top',
          end: 'bottom top',
          scrub: true,
          fastScrollEnd: true,
          preventOverlaps: true,
          invalidateOnRefresh: true,
          onRefresh: () => {
            offsets = calculateOffsets()
          },
        },
      })

      // 1. Wygaszenie podtytułu
      if (brandSubtitle) {
        heroTl.to(brandSubtitle, {
          opacity: 0,
          scale: 0.9,
          duration: 0.3,
          ease: 'power1.out',
        }, 0)
      }

      // 2. Skalowanie fontu do docelowego rozmiaru 1.25rem (20px)
      heroTl.to(brandTitle, {
        fontSize: '1.25rem',
        duration: 0.8,
        ease: 'power1.inOut',
      }, 0)

      // 3. Płynne dojście do lewego rogu
      heroTl.to(brandGroup, {
        x: 0,
        y: 0,
        duration: 0.8,
        ease: 'power1.inOut',
      }, 0)

      // 4. Aksamitne wyłonienie tła w końcówce Hero bez zmiany warstw GPU
      heroTl.to(
        navbarBg,
        {
          opacity: 1,
          duration: 0.15,
          ease: 'power1.inOut',
        },
        0.85
      )
    }
  })
</script>