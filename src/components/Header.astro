---
// Header.astro
---

<header
  data-navbar
  class="fixed top-0 inset-x-0 z-50 h-16 sm:h-20 flex items-center justify-between px-6 md:px-12 transition-all duration-500"
>
  <!-- Niezależna tafla szkła aktywowana przy scrollu -->
  <div
    data-navbar-bg
    class="absolute inset-0 bg-[#030C15]/80 backdrop-blur-xl border-b border-white/10 opacity-0 transition-opacity duration-300 pointer-events-none"
  ></div>

  <!-- Lewy slot: Logo techniczne -->
  <div class="relative z-10 flex items-center gap-3">
    <a href="#" class="group flex items-center gap-2.5 outline-none">
      <span class="w-2.5 h-2.5 rounded-none bg-[#00A3E0] rotate-45 transition-transform duration-300 group-hover:rotate-90"></span>
      <span class="font-display font-bold text-lg md:text-xl tracking-tight text-white uppercase group-hover:text-[#00A3E0] transition-colors">
        TK Flow
      </span>
      <span class="hidden sm:inline-block font-mono text-[9px] text-[#8FAEC4] tracking-widest uppercase border-l border-white/15 pl-2.5 ml-1">
        SYS.v26
      </span>
    </a>
  </div>

  <!-- Środek: Nawigacja do marek -->
  <nav class="hidden md:flex items-center gap-8 relative z-10 font-mono text-xs tracking-[0.18em] uppercase">
    <a
      href="https://sercemyjni.pl"
      target="_blank"
      rel="noopener noreferrer"
      class="group inline-flex items-center gap-1.5 text-[#8FAEC4] hover:text-white transition-colors py-1"
    >
      <span>Pompy Myjni</span>
      <svg class="w-3 h-3 opacity-60 transition-transform duration-200 group-hover:opacity-100 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" />
      </svg>
    </a>

    <a
      href="https://rurape.pl"
      target="_blank"
      rel="noopener noreferrer"
      class="group inline-flex items-center gap-1.5 text-[#8FAEC4] hover:text-white transition-colors py-1"
    >
      <span>Rury Nawadnianie</span>
      <svg class="w-3 h-3 opacity-60 transition-transform duration-200 group-hover:opacity-100 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" />
      </svg>
    </a>

    <a
      href="#about"
      class="text-[#8FAEC4] hover:text-white transition-colors py-1"
    >
      O marce
    </a>
  </nav>

  <!-- Prawy róg: Direct Contact -->
  <div class="relative z-10 flex items-center">
    <a
      href="tel:+48000000000"
      class="group inline-flex items-center gap-2 rounded-full px-4 py-2 bg-white/5 hover:bg-[#00A3E0]/15 border border-white/15 hover:border-[#00A3E0]/50 transition-all duration-300"
      aria-label="Zadzwoń do TK Flow"
    >
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-400"></span>
      </span>
      <span class="font-mono text-xs font-medium tracking-wider text-white">
        +48 000 000 000
      </span>
    </a>
  </div>
</header>

<script>
  import { DOMLoaded } from '@/ts/events'

  DOMLoaded(() => {
    const navbar = document.querySelector('[data-navbar]') as HTMLElement
    const navbarBg = document.querySelector('[data-navbar-bg]') as HTMLElement

    const handleScroll = () => {
      const isScrolled = window.scrollY > 40
      if (navbarBg) {
        navbarBg.style.opacity = isScrolled ? '1' : '0'
      }
      if (navbar) {
        navbar.classList.toggle('h-14', isScrolled)
        navbar.classList.toggle('sm:h-16', isScrolled)
      }
    }

    window.addEventListener('scroll', handleScroll, { passive: true })
    handleScroll()
  })
</script>