---
// Header.astro — Northvolt Minimalist Navbar
---

<header
  data-navbar
  class="fixed top-0 inset-x-0 z-50 h-20 flex items-center justify-between px-6 md:px-12 transition-all duration-300 pointer-events-none bg-white/95 backdrop-blur-md border-b border-black/5"
>
  <!-- Lewy slot: Minimalistyczne Logo -->
  <div class="relative z-10 flex items-center pointer-events-auto">
    <a href="#" class="flex items-center gap-4 outline-none group">
      <div class="w-8 h-8 bg-black flex items-center justify-center text-white font-bold text-sm">
        TK
      </div>
      <span class="font-bold text-xl tracking-tight text-black uppercase">
        TK Flow
      </span>
    </a>
  </div>

  <!-- Środek: Prosta nawigacja -->
  <nav class="hidden lg:flex items-center gap-8 relative z-10 font-medium text-sm text-black pointer-events-auto">
    <a href="https://rurape.pl" target="_blank" rel="noopener noreferrer" class="hover:text-black/60 transition-colors">
      Nawadnianie Rolnicze &nearr;
    </a>
    <a href="https://sercemyjni.pl" target="_blank" rel="noopener noreferrer" class="hover:text-black/60 transition-colors">
      Pompy Wysokociśnieniowe &nearr;
    </a>
    <a href="#about" class="hover:text-black/60 transition-colors">
      Doradztwo Techniczne
    </a>
  </nav>

  <!-- Prawy róg: Elegancki telefon -->
  <div class="relative z-10 flex items-center pointer-events-auto">
    <a
      href="tel:+48000000000"
      class="group flex items-center gap-3 text-black font-semibold text-sm hover:opacity-70 transition-opacity"
    >
      <span class="hidden sm:inline-block">Infolinia Inżynieryjna:</span>
      <span class="underline underline-offset-4 decoration-black/20">+48 000 000 000</span>
    </a>
  </div>
</header>