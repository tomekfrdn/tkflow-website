---
// Header.astro — Ostra siatka i hierarchia
---

<header class="fixed top-0 inset-x-0 z-50 bg-white/95 backdrop-blur-md border-b border-nv-border h-20 flex items-center px-6 md:px-12 transition-all duration-300">
  <div class="w-full max-w-[1600px] mx-auto flex items-center justify-between">
    
    <!-- Identyfikacja TK Flow -->
    <a href="/" class="flex items-center gap-4 group outline-none">
      <div class="w-8 h-8 bg-nv-black text-white flex items-center justify-center font-display font-bold text-sm tracking-tighter transition-transform group-hover:scale-105">
        TK
      </div>
      <div class="flex flex-col">
        <span class="font-display font-extrabold text-xl tracking-tight text-nv-black uppercase leading-none">
          TK Flow
        </span>
        <span class="text-[9px] text-nv-muted tracking-widest uppercase mt-1 font-bold">
          Przepływ Cieczy
        </span>
      </div>
    </a>

    <!-- Nawigacja Techniczna -->
    <nav class="hidden md:flex items-center gap-12 text-[11px] font-bold tracking-widest uppercase text-nv-muted">
      <a href="#ekosystem" class="hover:text-nv-black transition-colors flex items-center gap-2">
        <span class="w-1.5 h-1.5 bg-nv-border rounded-full"></span> Platformy
      </a>
      <a href="#doradztwo" class="hover:text-nv-black transition-colors flex items-center gap-2">
        <span class="w-1.5 h-1.5 bg-nv-border rounded-full"></span> Inżynieria
      </a>
    </nav>

    <!-- Bezpośrednia Infolinia -->
    <a href="tel:+48000000000" class="group flex items-center gap-3">
      <span class="hidden sm:block text-[10px] uppercase tracking-widest text-nv-muted font-bold group-hover:text-nv-black transition-colors">
        Infolinia:
      </span>
      <span class="font-display font-bold text-lg text-nv-black tracking-tight group-hover:text-nv-blue transition-colors">
        +48 000 000 000
      </span>
    </a>

  </div>
</header>