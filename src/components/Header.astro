<!-- Główny dokujący pasek nawigacyjny -->
<header
  data-navbar
  class="fixed top-0 inset-x-0 z-40 h-14 sm:h-16 pointer-events-none flex items-center justify-between px-4 sm:px-8 border-b border-transparent transition-all duration-300"
>
  <!-- Lewy slot: zadokowane logo pojawiające się po wyjściu z Hero -->
  <div data-navbar-brand class="flex items-center z-30 opacity-0 pointer-events-auto">
    <span class="text-base sm:text-lg font-semibold tracking-tight" style="color: #041A2F;">
      TK Flow
    </span>
  </div>

  <!-- Prawy róg: Button telefonu -->
  <div class="pointer-events-auto ml-auto z-30">
    <a
      data-phone-btn
      href="tel:+48000000000"
      style="background-color: #041A2F;"
      class="group inline-flex items-center gap-2 rounded-2xl px-3 py-1.5 sm:px-4 sm:py-2 text-white transition-transform duration-200 hover:scale-[1.02] active:scale-95 shadow-md border border-white/10"
      aria-label="Zadzwoń do TK Flow"
    >
      <span class="text-[10px] sm:text-xs font-semibold uppercase tracking-wider text-white/80 group-hover:text-white transition-colors">
        Zadzwoń
      </span>
      <span class="relative flex h-1.5 w-1.5 sm:h-2 sm:w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-1.5 w-1.5 sm:h-2 sm:w-2 bg-emerald-400"></span>
      </span>
      <span class="font-mono text-xs sm:text-sm font-medium tracking-tight text-white">
        +48 000 000 000
      </span>
    </a>
  </div>
</header>

<!-- Centralny kinetyczny nagłówek Hero (zawsze trzyma środek symetrii w sekcji Hero) -->
<div
  data-header-center
  class="fixed inset-x-0 top-[calc(50%-8vh)] px-4 sm:px-8 text-[clamp(2.25rem,7vw,5rem)] leading-none z-20 pointer-events-none select-none flex justify-center"
>
  <h1 class="w-full text-center font-semibold tracking-tight">
    <span
      data-title
      class="inline-block whitespace-nowrap"
      style="color: #041A2F;"
    >
      TK Flow
    </span>
    <span
      data-subtitle
      class="block text-[clamp(0.75rem,1.2vw,0.875rem)] font-light tracking-[0.25em] sm:tracking-[0.3em] text-white/90 uppercase mt-3 sm:mt-4 max-w-md mx-auto"
    >
      technologie przesyłu cieczy
    </span>
  </h1>
</div>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  import { DOMLoaded } from '@/ts/events'

  DOMLoaded(() => {
    gsap.registerPlugin(ScrollTrigger)

    const hero = document.querySelector('[data-hero]') as HTMLElement
    const about = document.querySelector('[data-about]') as HTMLElement
    const navbar = document.querySelector('[data-navbar]') as HTMLElement
    const headerCenter = document.querySelector('[data-header-center]') as HTMLElement
    const subtitle = headerCenter?.querySelector('[data-subtitle]') as HTMLElement
    const title = headerCenter?.querySelector('[data-title]') as HTMLElement
    const navbarBrand = document.querySelector('[data-navbar-brand]') as HTMLElement

    if (hero && headerCenter && navbar) {
      // Oś czasu dla Hero: ruch WYŁĄCZNIE po osi pionowej, z zachowaniem idealnego środka
      const heroTl = gsap.timeline({
        scrollTrigger: {
          trigger: hero,
          start: 'top top',
          end: 'bottom 15%',
          scrub: true,
          invalidateOnRefresh: true,
        },
      })

      // Krok 1: Wygaszenie podtytułu w pierwszej kolejności (0% -> 40% przewijania Hero)
      if (subtitle) {
        heroTl.to(subtitle, {
          opacity: 0,
          y: -12,
          duration: 0.4,
          ease: 'power1.out',
        }, 0)
      }

      // Krok 2: Skalowanie i podciąganie napisu centralnego dokładnie w pionie na wysokość belki
      heroTl.to(headerCenter, {
        fontSize: '1.25rem',
        top: '1.15rem',
        duration: 0.8,
        ease: 'none',
      }, 0)

      // Krok 3: Na samym końcu Hero centralny napis znika, a pałeczkę przejmuje lewy brand na pasku
      heroTl.to(headerCenter, {
        opacity: 0,
        duration: 0.2,
        ease: 'power1.in',
      }, 0.8)

      // 2. Aktywacja belki i pojawienie się lewego logo DOKŁADNIE na wejściu sekcji About
      if (about) {
        ScrollTrigger.create({
          trigger: about,
          start: 'top 60px',
          onEnter: () => {
            gsap.to(navbar, {
              backgroundColor: 'rgba(0, 163, 224, 0.95)',
              backdropFilter: 'blur(12px)',
              borderColor: 'rgba(255, 255, 255, 0.15)',
              duration: 0.25,
            })
            if (navbarBrand) {
              gsap.to(navbarBrand, {
                opacity: 1,
                x: 0,
                duration: 0.25,
                ease: 'power2.out',
              })
            }
          },
          onLeaveBack: () => {
            gsap.to(navbar, {
              backgroundColor: 'rgba(0, 163, 224, 0)',
              backdropFilter: 'blur(0px)',
              borderColor: 'rgba(255, 255, 255, 0)',
              duration: 0.25,
            })
            if (navbarBrand) {
              gsap.to(navbarBrand, {
                opacity: 0,
                duration: 0.2,
                ease: 'power2.in',
              })
            }
          },
        })
      }
    }
  })
</script>