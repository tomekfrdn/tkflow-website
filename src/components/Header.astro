---
// Header.astro — Architektura zaufania i natychmiastowego kontaktu
---

<header
  data-navbar
  class="fixed top-0 inset-x-0 z-50 h-16 sm:h-20 flex items-center justify-between px-5 sm:px-8 md:px-12 transition-all duration-300 pointer-events-none"
>
  <!-- Płynny szklany blur aktywowany przy scrollowaniu -->
  <div
    data-navbar-bg
    class="absolute inset-0 bg-[#041A2F]/90 backdrop-blur-lg border-b border-white/10 opacity-0 transition-opacity duration-300 pointer-events-none shadow-md"
  ></div>

  <!-- Lewy slot: Logo i tożsamość firmy -->
  <div class="relative z-10 flex items-center gap-3 pointer-events-auto">
    <a href="#" class="group flex items-center gap-3 outline-none">
      <div class="w-9 h-9 rounded-lg bg-gradient-to-tr from-[#005B99] to-[#0098E0] flex items-center justify-center text-white font-display font-extrabold text-sm shadow-md group-hover:scale-105 transition-transform">
        TK
      </div>
      <div class="flex flex-col">
        <span class="font-display font-extrabold text-lg tracking-tight text-white uppercase leading-none drop-shadow-sm">
          TK Flow
        </span>
        <span class="font-mono text-[9px] text-[#8FAEC4] tracking-wider uppercase mt-1 font-semibold">
          Przesył Cieczy // Bydgoszcz
        </span>
      </div>
    </a>
  </div>

  <!-- Środek: Dwa strumienie w nawigacji -->
  <nav class="hidden lg:flex items-center gap-6 relative z-10 font-mono text-xs tracking-wider uppercase pointer-events-auto">
    <a
      href="https://rurape.pl"
      target="_blank"
      rel="noopener noreferrer"
      class="group inline-flex items-center gap-2 py-1.5 px-3 rounded-md text-white/80 hover:text-white bg-white/5 hover:bg-emerald-500/20 border border-white/10 hover:border-emerald-400/40 transition-all font-medium"
    >
      <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
      <span>Nawadnianie: rurape.pl</span>
      <svg class="w-3.5 h-3.5 opacity-60 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" />
      </svg>
    </a>

    <a
      href="https://sercemyjni.pl"
      target="_blank"
      rel="noopener noreferrer"
      class="group inline-flex items-center gap-2 py-1.5 px-3 rounded-md text-white/80 hover:text-white bg-white/5 hover:bg-rose-500/20 border border-white/10 hover:border-rose-400/40 transition-all font-medium"
    >
      <span class="w-2 h-2 rounded-full bg-rose-400"></span>
      <span>Pompy Myjni: sercemyjni.pl</span>
      <svg class="w-3.5 h-3.5 opacity-60 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" />
      </svg>
    </a>

    <a
      href="#about"
      class="text-[#8FAEC4] hover:text-white transition-colors py-1.5 px-2 font-medium"
    >
      Doradca
    </a>
  </nav>

  <!-- Prawy róg: Bezpośredni telefon (kluczowy CTA dla klienta 40-60 lat) -->
  <div class="relative z-10 flex items-center pointer-events-auto">
    <a
      href="tel:+48000000000"
      class="group inline-flex items-center gap-3 rounded-full px-4 py-2 bg-gradient-to-r from-[#005B99] to-[#0098E0] hover:from-[#006BB3] hover:to-[#00A8F5] text-white shadow-lg transition-all duration-300 hover:scale-[1.02] border border-white/20"
      aria-label="Zadzwoń do Tomasza Kulpy"
    >
      <span class="relative flex h-2.5 w-2.5">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-400"></span>
      </span>
      <div class="flex flex-col text-left">
        <span class="text-[9px] uppercase tracking-wider text-white/80 leading-none font-mono">
          Tomasz Kulpa &middot; Infolinia
        </span>
        <span class="font-mono text-xs sm:text-sm font-bold tracking-tight text-white mt-0.5">
          +48 000 000 000
        </span>
      </div>
    </a>
  </div>
</header>

<script>
  import { DOMLoaded } from '@/ts/events'

  DOMLoaded(() => {
    const navbarBg = document.querySelector('[data-navbar-bg]') as HTMLElement

    const handleScroll = () => {
      const isScrolled = window.scrollY > 30
      if (navbarBg) navbarBg.style.opacity = isScrolled ? '1' : '0'
    }

    window.addEventListener('scroll', handleScroll, { passive: true })
    handleScroll()
  })
</script>