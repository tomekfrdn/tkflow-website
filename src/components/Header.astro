---
// Header.astro — Reprezentacyjny, czysty pasek nawigacji
---

<header
  data-navbar
  class="fixed top-0 inset-x-0 z-50 h-16 sm:h-20 flex items-center justify-between px-5 sm:px-8 md:px-12 transition-all duration-300 pointer-events-none"
>
  <div
    data-navbar-bg
    class="absolute inset-0 bg-white/95 backdrop-blur-md border-b border-slate-200/80 opacity-0 transition-opacity duration-300 pointer-events-none shadow-sm"
  ></div>

  <!-- Lewy slot: Minimalistyczny logotyp -->
  <div class="relative z-10 flex items-center gap-3 pointer-events-auto">
    <a href="#" class="group flex items-center gap-3 outline-none">
      <div class="w-8 h-8 rounded bg-[#0B1523] flex items-center justify-center text-white font-extrabold text-sm group-hover:bg-[#0066CC] transition-colors shadow-sm">
        TK
      </div>
      <div class="flex flex-col">
        <span class="font-extrabold text-lg tracking-tighter text-[#0B1523] uppercase leading-none">
          TK Flow
        </span>
        <span class="font-mono text-[9px] text-slate-500 tracking-widest uppercase mt-0.5 font-semibold">
          Przesył Cieczy
        </span>
      </div>
    </a>
  </div>

  <!-- Środek: Nawigacja -->
  <nav class="hidden lg:flex items-center gap-8 relative z-10 font-mono text-xs tracking-wider uppercase pointer-events-auto">
    <a
      href="https://rurape.pl"
      target="_blank"
      rel="noopener noreferrer"
      class="text-slate-600 hover:text-[#059669] transition-colors font-semibold flex items-center gap-1.5"
    >
      <span>Rury Nawadnianie</span>
      <span class="text-[10px]">&nearr;</span>
    </a>

    <a
      href="https://sercemyjni.pl"
      target="_blank"
      rel="noopener noreferrer"
      class="text-slate-600 hover:text-[#DC2626] transition-colors font-semibold flex items-center gap-1.5"
    >
      <span>Pompy Myjni</span>
      <span class="text-[10px]">&nearr;</span>
    </a>

    <a
      href="#about"
      class="text-slate-600 hover:text-[#0B1523] transition-colors font-semibold"
    >
      O doradcy
    </a>
  </nav>

  <!-- Prawy róg: Autorytatywny telefon -->
  <div class="relative z-10 flex items-center pointer-events-auto">
    <a
      href="tel:+48000000000"
      class="group inline-flex items-center gap-3 rounded-full px-4 py-2 bg-[#0B1523] hover:bg-[#0066CC] text-white transition-all duration-300 shadow-md hover:shadow-lg hover:-translate-y-0.5"
      aria-label="Zadzwoń do Tomasza Kulpy"
    >
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-400"></span>
      </span>
      <div class="flex flex-col text-left">
        <span class="text-[9px] uppercase tracking-wider text-slate-300 group-hover:text-white leading-none font-mono">
          Tomasz Kulpa &middot; Doradztwo
        </span>
        <span class="font-mono text-xs sm:text-sm font-bold tracking-tight text-white mt-0.5">
          +48 000 000 000
        </span>
      </div>
    </a>
  </div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const navbarBg = document.querySelector('[data-navbar-bg]') as HTMLElement

    const handleScroll = () => {
      const isScrolled = window.scrollY > 10
      if (navbarBg) navbarBg.style.opacity = isScrolled ? '1' : '0'
    }

    window.addEventListener('scroll', handleScroll, { passive: true })
    handleScroll()
  })
</script>