---
// Header.astro — Styl Northvolt: Architektoniczna linia, maksymalna czystość
---

<header
  data-navbar
  class="fixed top-0 inset-x-0 z-50 h-16 sm:h-20 flex items-center justify-between px-6 md:px-12 bg-[#0D0F12]/90 backdrop-blur-md border-b border-white/10"
>
  <!-- Lewa strona: Logo jako surowy znak architektoniczny -->
  <div class="flex items-center gap-4">
    <a href="#" class="flex items-baseline gap-3 group">
      <span class="text-xl sm:text-2xl font-bold tracking-tight text-white uppercase group-hover:text-white/80 transition-colors">
        TK FLOW
      </span>
      <span class="text-[11px] tracking-widest text-white/40 uppercase hidden sm:inline-block font-normal">
        Systems
      </span>
    </a>
  </div>

  <!-- Środek: Czyste odnośniki modularne -->
  <nav class="hidden md:flex items-center gap-8 text-xs tracking-wider uppercase text-[#9AA1A9]">
    <a
      href="https://rurape.pl"
      target="_blank"
      rel="noopener noreferrer"
      class="hover:text-white transition-colors flex items-center gap-1.5"
    >
      <span>01 / Rurociągi Agro</span>
      <span class="text-[10px] text-white/30">&nearr;</span>
    </a>

    <a
      href="https://sercemyjni.pl"
      target="_blank"
      rel="noopener noreferrer"
      class="hover:text-white transition-colors flex items-center gap-1.5"
    >
      <span>02 / Pompy Wysokociśnieniowe</span>
      <span class="text-[10px] text-white/30">&nearr;</span>
    </a>

    <a
      href="#about"
      class="hover:text-white transition-colors"
    >
      O nas
    </a>

    <a
      href="#contact"
      class="hover:text-white transition-colors"
    >
      Kontakt
    </a>
  </nav>

  <!-- Prawa strona: Bezpośredni kontakt -->
  <div class="flex items-center">
    <a
      href="tel:+48000000000"
      class="text-xs uppercase tracking-wider text-white border border-white/20 hover:border-white px-4 py-2 rounded-none transition-colors"
    >
      +48 000 000 000
    </a>
  </div>
</header>