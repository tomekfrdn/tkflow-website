<header
  data-header
  class="fixed inset-x-2 top-[calc(50%-10vh)] text-[10vw] leading-none z-20 pointer-events-none select-none"
>
  <h1 class="text-center font-semibold tracking-tight">
    <span 
      data-title 
      class="inline-block whitespace-nowrap" 
      style="color: #041A2F;"
    >
      TK Flow
    </span>
    <span 
      data-subtitle 
      class="block text-[0.28em] font-normal tracking-wider uppercase mt-2" 
      style="color: #ffffff;"
    >
      technologie przesyłu cieczy
    </span>
  </h1>
</header>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  import { DOMLoaded } from '@/ts/events'

  DOMLoaded(() => {
    gsap.registerPlugin(ScrollTrigger)

    const hero = document.querySelector('[data-hero]') as HTMLElement
    const header = document.querySelector('[data-header]') as HTMLElement
    const title = header?.querySelector('[data-title]') as HTMLElement
    const subtitle = header?.querySelector('[data-subtitle]') as HTMLElement

    const aboutSection = document.querySelector('[data-about]') as HTMLElement
    const projectsSection = document.querySelector('[data-projects]') as HTMLElement
    const contactSection = document.querySelector('[data-contact]') as HTMLElement

    if (hero && header) {
      // 1. Zmniejszanie i dokowanie logo do górnej krawędzi
      gsap.to(header, {
        scrollTrigger: {
          trigger: hero,
          start: 'top top',
          end: 'bottom 25%',
          scrub: true,
        },
        fontSize: '1.75rem',
        top: '1.25rem',
        ease: 'none',
      })

      // 2. Wygaszenie podtytułu podczas zjeżdżania z Hero
      if (subtitle) {
        gsap.to(subtitle, {
          scrollTrigger: {
            trigger: hero,
            start: 'top top',
            end: 'center top',
            scrub: true,
          },
          opacity: 0,
          y: -10,
          ease: 'none',
        })
      }
    }

    // 3. Bezzwłoczne (skokowe) przełączanie kolorów logo w punktach przecięcia sekcji
    if (title) {
      // Przejście Hero -> About: natychmiastowy przeskok z granatu na czystą biel
      if (aboutSection) {
        ScrollTrigger.create({
          trigger: aboutSection,
          start: 'top 40px', // Punkt, w którym sekcja styka się z zadokowanym logo
          end: 'bottom 40px',
          onEnter: () => gsap.set(title, { color: '#ffffff' }),
          onLeaveBack: () => gsap.set(title, { color: '#041A2F' }),
        })
      }

      // Przejście About -> Projects: natychmiastowy powrót do granatu na jasnym tle
      if (projectsSection) {
        ScrollTrigger.create({
          trigger: projectsSection,
          start: 'top 40px',
          end: 'bottom 40px',
          onEnter: () => gsap.set(title, { color: '#041A2F' }),
          onLeaveBack: () => gsap.set(title, { color: '#ffffff' }),
        })
      }

      // Przejście Projects -> Contact: natychmiastowy powrót do bieli
      if (contactSection) {
        ScrollTrigger.create({
          trigger: contactSection,
          start: 'top 40px',
          end: 'bottom 40px',
          onEnter: () => gsap.set(title, { color: '#ffffff' }),
          onLeaveBack: () => gsap.set(title, { color: '#041A2F' }),
        })
      }
    }
  })
</script>