<!-- Główny pasek nawigacyjny: h-14 na mobile / h-16 na desktopie -->
<header
  data-navbar
  class="fixed top-0 inset-x-0 z-40 h-14 sm:h-16 flex items-center justify-between px-4 sm:px-8 border-b border-transparent pointer-events-none select-none"
>
  <!-- Niezależna warstwa tła (eliminuje mruganie GPU) -->
  <div
    data-navbar-bg
    class="absolute inset-0 bg-[#00a3e0]/95 backdrop-blur-md border-b border-white/15 opacity-0 pointer-events-none will-change-[opacity]"
  ></div>

  <!-- Lewy slot: semantyczny nagłówek H1 z kinetycznym ruchem i podtytułem -->
  <div data-brand-anchor class="relative flex items-center z-30">
    <h1 data-brand-group class="relative flex flex-col items-start justify-center m-0 p-0 origin-left">
      <span
        data-brand-title
        class="inline-block font-semibold tracking-tight whitespace-nowrap leading-none origin-left antialiased subpixel-antialiased [transform:translateZ(0)]"
        style="color: #041A2F;"
      >
        TK Flow
      </span>
      
      <!-- Podtytuł wycentrowany pod napisem w widoku Hero -->
      <span
        data-brand-subtitle
        class="absolute top-full left-1/2 -translate-x-1/2 block text-[clamp(0.75rem,1.2vw,0.875rem)] font-light tracking-[0.25em] sm:tracking-[0.3em] text-white/90 uppercase mt-3 whitespace-nowrap pointer-events-none"
      >
        technologie przesyłu cieczy
      </span>
    </h1>
  </div>

  <!-- Środek na desktopie: Editorial Navigation z linkami zewnętrznymi i strzałką ↗ -->
  <nav
    data-navbar-nav
    class="hidden md:flex absolute left-1/2 -translate-x-1/2 top-1/2 -translate-y-1/2 items-center gap-10 z-30 pointer-events-auto opacity-0"
  >
    <a
      href="https://sercemyjni.pl"
      target="_blank"
      rel="noopener noreferrer"
      class="group relative inline-flex items-center gap-1.5 py-1 text-xs uppercase tracking-[0.2em] font-medium text-white transition-opacity duration-200"
    >
      <span>Pompy do myjni</span>
      <svg
        class="w-3 h-3 opacity-70 transition-all duration-200 group-hover:opacity-100 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
        fill="none"
        stroke="currentColor"
        stroke-width="2.2"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" />
      </svg>
      <span class="absolute bottom-0 left-0 w-0 h-px bg-white transition-all duration-300 ease-out group-hover:w-full"></span>
      <span class="sr-only">(otwiera się w nowej karcie)</span>
    </a>

    <a
      href="https://rurape.pl"
      target="_blank"
      rel="noopener noreferrer"
      class="group relative inline-flex items-center gap-1.5 py-1 text-xs uppercase tracking-[0.2em] font-medium text-white transition-opacity duration-200"
    >
      <span>Rury PE do nawadniania</span>
      <svg
        class="w-3 h-3 opacity-70 transition-all duration-200 group-hover:opacity-100 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
        fill="none"
        stroke="currentColor"
        stroke-width="2.2"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" />
      </svg>
      <span class="absolute bottom-0 left-0 w-0 h-px bg-white transition-all duration-300 ease-out group-hover:w-full"></span>
      <span class="sr-only">(otwiera się w nowej karcie)</span>
    </a>
  </nav>

  <!-- Prawy róg: Button szybkiego kontaktu -->
  <div class="pointer-events-auto ml-auto z-30 flex items-center">
    <a
      data-phone-btn
      href="tel:+48000000000"
      style="background-color: #041A2F;"
      class="group inline-flex items-center justify-center gap-1.5 sm:gap-2 rounded-2xl px-3 py-2 sm:px-4 sm:py-2.5 text-white transition-transform duration-200 hover:scale-[1.02] active:scale-95 shadow-md border border-white/10"
      aria-label="Zadzwoń do TK Flow"
    >
      <span class="text-[10px] sm:text-xs font-semibold uppercase tracking-wider text-white/80 group-hover:text-white transition-colors leading-none flex items-center">
        Zadzwoń
      </span>

      <span class="relative flex h-1.5 w-1.5 sm:h-2 sm:w-2 shrink-0 self-center">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-1.5 w-1.5 sm:h-2 sm:w-2 bg-emerald-400"></span>
      </span>

      <span class="font-mono text-xs sm:text-sm font-medium tracking-tight text-white leading-none flex items-center">
        +48 000 000 000
      </span>
    </a>
  </div>
</header>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  import { DOMLoaded } from '@/ts/events'

  DOMLoaded(() => {
    if (typeof window === 'undefined') return

    gsap.registerPlugin(ScrollTrigger)

    const hero = document.querySelector('[data-hero]') as HTMLElement
    const navbarBg = document.querySelector('[data-navbar-bg]') as HTMLElement
    const navbarNav = document.querySelector('[data-navbar-nav]') as HTMLElement
    const brandGroup = document.querySelector('[data-brand-group]') as HTMLElement
    const brandTitle = document.querySelector('[data-brand-title]') as HTMLElement
    const brandSubtitle = document.querySelector('[data-brand-subtitle]') as HTMLElement

    if (hero && navbarBg && brandGroup && brandTitle) {
      const calculateOffsets = () => {
        const startFontSize = Math.min(Math.max(window.innerWidth * 0.07, 36), 80)
        gsap.set(brandTitle, { fontSize: `${startFontSize}px` })

        const rect = brandTitle.getBoundingClientRect()
        const targetX = (window.innerWidth / 2) - (rect.width / 2) - rect.left
        const targetY = (window.innerHeight * 0.42) - rect.top

        return { targetX, targetY }
      }

      let offsets = calculateOffsets()

      // Stan początkowy w Hero
      gsap.set(brandGroup, {
        x: offsets.targetX,
        y: offsets.targetY,
        force3D: true,
      })

      const heroTl = gsap.timeline({
        scrollTrigger: {
          trigger: hero,
          start: 'top top',
          end: 'bottom top',
          scrub: true,
          fastScrollEnd: true,
          preventOverlaps: true,
          invalidateOnRefresh: true,
          onRefresh: () => {
            if (window.scrollY < 10) {
              offsets = calculateOffsets()
            }
          },
          // Gdy animacja dojdzie do końca (lewy róg), zdejmujemy transformację 3D
          onLeave: () => {
            gsap.set(brandGroup, { clearProps: 'transform' })
          },
          onEnterBack: () => {
            gsap.set(brandGroup, { x: 0, y: 0 })
          }
        },
      })

      // 1. Wygaszenie podtytułu
      if (brandSubtitle) {
        heroTl.to(brandSubtitle, {
          opacity: 0,
          scale: 0.9,
          duration: 0.3,
          ease: 'power1.out',
        }, 0)
      }

      // 2. Skalowanie fontu do belki
      heroTl.to(brandTitle, {
        fontSize: '1.25rem',
        duration: 0.8,
        ease: 'power1.inOut',
      }, 0)

      // 3. Dojście do lewego rogu
      heroTl.to(brandGroup, {
        x: 0,
        y: 0,
        duration: 0.8,
        ease: 'power1.inOut',
      }, 0)

      // 4. Pokazanie tła paska
      heroTl.to(
        navbarBg,
        {
          opacity: 1,
          duration: 0.15,
          ease: 'power1.inOut',
        },
        0.85
      )

      // 5. Pokazanie środkowej nawigacji
      if (navbarNav) {
        heroTl.to(
          navbarNav,
          {
            opacity: 1,
            duration: 0.15,
            ease: 'power1.inOut',
          },
          0.85
        )
      }

      // Synchronizacja po odświeżeniu
      const currentScroll = window.scrollY || document.documentElement.scrollTop
      if (currentScroll >= (hero.offsetHeight || 500)) {
        heroTl.progress(1)
        gsap.set(brandGroup, { clearProps: 'transform' })
      } else {
        ScrollTrigger.refresh()
      }
    }
  })
</script>