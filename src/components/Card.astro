---
import { Image } from 'astro:assets'

interface Props {
  image: ImageMetadata
  title: string
  description: string
  link: string
  badge: string
  accentColor: string
}

const {
  image,
  title,
  description,
  link,
  badge,
  accentColor = '#00a3e0'
} = Astro.props
---

<article
  class="group relative flex flex-col w-full max-w-[24rem] sm:max-w-[26rem] lg:max-w-[28rem] bg-white rounded-2xl overflow-hidden border border-slate-200/90 shadow-sm transition-all duration-300 hover:shadow-xl hover:shadow-[#041A2F]/10 hover:-translate-y-1.5"
>
  <!-- Górna krawędź akcentująca markę -->
  <div
    class="h-1.5 w-full transition-all duration-300 opacity-90 group-hover:opacity-100"
    style={`background-color: ${accentColor};`}
  ></div>

  <figure class="flex flex-col flex-1 m-0">
    <!-- Kontener obrazu w dokładnych proporcjach 1200/895 -->
    <div class="relative overflow-hidden aspect-[1200/895] bg-slate-100">
      <Image
        class="w-full h-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-105"
        src={image}
        alt={`Prezentacja produktów ${title}`}
        loading="lazy"
        decoding="async"
      />

      <!-- Pływający chip ze strzałką kierunkową (External link) -->
      <div 
        class="absolute top-4 right-4 z-10 w-10 h-10 rounded-full bg-white/95 backdrop-blur-md flex items-center justify-center text-[#041A2F] shadow-md border border-slate-100 transition-all duration-300 group-hover:scale-110 group-hover:text-white"
        style={`--accent: ${accentColor};`}
      >
        <svg
          class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" />
        </svg>
      </div>
    </div>

    <!-- Treść karty o wysokim kontraście -->
    <figcaption class="flex flex-col flex-1 justify-between p-6 sm:p-8 gap-6">
      <div class="flex flex-col gap-3">
        <!-- Brand Pill Badge ze wskaźnikiem statusu w kolorze marki -->
        <div class="inline-flex items-center gap-2 self-start px-3 py-1 rounded-full text-xs font-semibold tracking-wider uppercase border border-slate-200/60 bg-slate-50">
          <span
            class="w-2 h-2 rounded-full shrink-0"
            style={`background-color: ${accentColor};`}
          ></span>
          <span class="text-[#041A2F] font-mono text-[11px]">
            {badge}
          </span>
        </div>

        <!-- Tytuł z mocnym, głębokim kolorem -->
        <h3 class="text-2xl sm:text-3xl font-bold tracking-tight text-[#041A2F] transition-colors duration-200 group-hover:opacity-90">
          {title}
        </h3>

        <!-- Opis o podwyższonej czytelności (zamiast mdłego szarego) -->
        <p class="text-sm sm:text-base font-normal text-[#2b3a4a] leading-relaxed">
          {description}
        </p>
      </div>

      <!-- Dolny link CTA z wyrazistym akcentem marki -->
      <div class="inline-flex items-center justify-between pt-5 border-t border-slate-100 text-sm font-semibold tracking-wide text-[#041A2F]">
        <span class="group-hover:translate-x-0.5 transition-transform duration-200">
          Przejdź na stronę
        </span>
        <span
          class="inline-flex items-center justify-center w-7 h-7 rounded-full transition-transform duration-300 group-hover:translate-x-1"
          style={`color: ${accentColor};`}
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </span>
      </div>
    </figcaption>
  </figure>

  <!-- Niewidoczna warstwa linku obejmująca całą kartę -->
  <a
    href={link}
    target="_blank"
    rel="noopener noreferrer"
    class="absolute inset-0 z-20"
    aria-label={`Odwiedź stronę ${title}`}
  >
    <span class="sr-only">Odwiedź stronę {title}</span>
  </a>
</article>

<style>
  .group:hover [style*="--accent"] {
    background-color: var(--accent);
  }
</style>